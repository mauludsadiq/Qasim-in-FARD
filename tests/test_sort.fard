import("std/list") as list

let nums = [3, 1, 4, 1, 5, 9, 2, 6]
let sorted = list.sort_by(nums, fn(a, b) { a - b })
let sorted_desc = list.sort_by(nums, fn(a, b) { b - a })

let records = [
  { mid: 200, venue: "NYSE" },
  { mid: 100, venue: "NASDAQ" },
  { mid: 150, venue: "CBOE" }
]
let sorted_records = list.sort_by(records, fn(a, b) { a.mid - b.mid })

{ sorted: sorted, sorted_desc: sorted_desc, sorted_records: sorted_records }
