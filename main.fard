fn post_price(req) {
  let p = json.decode(req.body)
  let payload_json = require_text(p, "payload_json")
  let issuer_pk_hex = require_text(p, "issuer_pk_hex")
  let sig_b64 = require_text(p, "sig_b64")

  if payload_json == "" then err_json(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json(400, "missing sig_b64")
  else if !verify_payload(issuer_pk_hex, sig_b64, payload_json) then err_json(401, "bad sig")
  else
    let d = hex_digest(payload_json) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR IGNORE INTO price_claims (digest,symbol,mid,venue,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      d, "','",
      require_text(p, "symbol"), "',",
      str.from(require_num(p, "mid")), ",'",
      require_text(p, "venue"), "',",
      str.from(require_num(p, "ts_unix")), ",'",
      issuer_pk_hex, "','",
      sig_b64, "','",
      payload_json, "')"
    ])) in
    ok_json({ digest: d })
}

fn adapt_price(feed_type, src) {
  if feed_type == "simple_json" then
    { ok: true, mid: require_num(src, "mid"), ts_unix: require_num(src, "ts_unix") }
  else if feed_type == "coindesk" then
    if rec.has(src, "bpi") && rec.has(src.bpi, "USD") then
      { ok: true, mid: require_num(src.bpi.USD, "rate_float"), ts_unix: 0 }
    else
      { ok: false, error: "coindesk adapter missing bpi.USD.rate_float" }
  else
    { ok: false, error: str.concat(["unknown feed_type: ", feed_type]) }
}

fn post_live_price(req) {
  let body = json.decode(req.body)
  let symbol = require_text(body, "symbol")
  let venue = require_text(body, "venue")
  let url = require_text(body, "url")
  let feed_type = if rec.has(body, "feed_type") then rec.get(body, "feed_type") else "simple_json"
  let issuer_pk_hex = require_text(body, "issuer_pk_hex")
  let signing_secret_hex = require_text(body, "signing_secret_hex")

  if symbol == "" then err_json(400, "missing symbol")
  else if venue == "" then err_json(400, "missing venue")
  else if url == "" then err_json(400, "missing url")
  else if issuer_pk_hex == "" then err_json(400, "missing issuer_pk_hex")
  else if signing_secret_hex == "" then err_json(400, "missing signing_secret_hex")
  else
    let resp = http.get(url) in
    let src = json.decode(resp.body) in
    let adapted = adapt_price(feed_type, src) in
    if !adapted.ok then err_json(400, adapted.error)
    else if adapted.mid == 0 then err_json(400, "adapter produced mid=0")
    else if adapted.ts_unix == 0 && feed_type == "simple_json" then err_json(400, "adapter produced ts_unix=0")
    else
      let mid = adapted.mid in
      let ts_unix = adapted.ts_unix in
      let payload = { symbol: symbol, mid: mid, ts_unix: ts_unix, venue: venue } in
      let payload_json = json.canonicalize(payload) in
      let d = hex_digest(payload_json) in
      let source_body_digest = hash.sha256_text(resp.body) in
      let receipt = {
        source_url: url,
        source_body_digest: source_body_digest,
        feed_type: feed_type,
        symbol: symbol,
        venue: venue,
        mid: mid,
        ts_unix: ts_unix
      } in
      let receipt_json = json.canonicalize(receipt) in
      let receipt_digest = hash.sha256_text(receipt_json) in
      let sig_hex = crypto.hmac_sha256(signing_secret_hex, receipt_json) in
      let sig_b64 = b64.encode(bytes.from_hex(sig_hex)) in
      let _ = sqlite.exec(db, str.concat([
        "INSERT OR IGNORE INTO price_claims (digest,symbol,mid,venue,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
        d, "','",
        symbol, "',",
        str.from(mid), ",'",
        venue, "',",
        str.from(ts_unix), ",'",
        issuer_pk_hex, "','",
        sig_b64, "','",
        payload_json, "')"
      ])) in
      ok_json({
        digest: d,
        symbol: symbol,
        venue: venue,
        feed_type: feed_type,
        source_url: url,
        source_body_digest: source_body_digest,
        receipt_digest: receipt_digest,
        receipt_json: receipt_json,
        issuer_pk_hex: issuer_pk_hex,
        sig_b64: sig_b64,
        mid: mid,
        ts_unix: ts_unix
      })
}

fn require_body(req, next) {
  if req.body == "" || req.body == null
    then err_json(400, "request body required")
    else next(req)
}

fn verify_chain() {
  let rows = sqlite.query(db, "SELECT seq,chain_digest,payload_json FROM receipt_log ORDER BY seq ASC") in
  let result = list.fold(rows, { ok: true, prev: "GENESIS", failed_at: null, checked: 0 }, fn(acc, row) {
    if !acc.ok then acc
    else
      let expected = hash.sha256_text(row.payload_json) in
      let digest_ok = expected == row.chain_digest in
      let parsed = json.decode(row.payload_json) in
      let prev_ok = parsed.prev_chain_digest == acc.prev in
      if !digest_ok then { ok: false, prev: acc.prev, failed_at: row.seq, checked: acc.checked + 1, reason: "digest_mismatch", expected: expected, stored: row.chain_digest }
      else if !prev_ok then { ok: false, prev: acc.prev, failed_at: row.seq, checked: acc.checked + 1, reason: "chain_broken", expected_prev: acc.prev, stored_prev: parsed.prev_chain_digest }
      else { ok: true, prev: row.chain_digest, failed_at: null, checked: acc.checked + 1 }
  }) in
  if result.ok
    then ok_json({ valid: true, checked: result.checked, head: list.fold(rows, "GENESIS", fn(acc, r) { r.chain_digest }) })
    else ok_json({ valid: false, checked: result.checked, failed_at: result.failed_at, reason: result.reason })
}

fn handle(req) {
  let res = if req.path == "/health" then health()
  else if req.path == "/finance/ingest/tx" then require_body(req, post_tx)
  else if req.path == "/finance/ingest/cash" then require_body(req, post_cash)
  else if req.path == "/finance/ingest/order" then require_body(req, post_order)
  else if req.path == "/finance/ingest/fill" then require_body(req, post_fill)
  else if req.path == "/finance/price/claim" then require_body(req, post_price)
  else if req.path == "/finance/live/price" then require_body(req, post_live_price)
  else if req.path == "/finance/chain/verify" then verify_chain()
  else if req.path == "/finance/replay" then qasim_http.replay(req, qasim_state, ok_json)
  else if str.starts_with(req.path, "/finance/price/aggregate/") then qasim_http.price_aggregate(req, db, qasim_prices, ok_json)
  else if str.starts_with(req.path, "/finance/export_at/") then qasim_http.export_account_at(req, db, qasim_prices, qasim_state, MAX_PRICE_AGE, ok_json, err_json)
  else if str.starts_with(req.path, "/finance/export/") then qasim_http.export_account(req, db, qasim_prices, qasim_state, ok_json)
  else if str.starts_with(req.path, "/finance/state_payload/") then qasim_http.state_payload_at(req, db, qasim_prices, qasim_state, MAX_PRICE_AGE, ok_json, err_json)
  else if str.starts_with(req.path, "/finance/scenario_at/") then qasim_http.scenario_at(req, db, qasim_prices, qasim_state, qasim_scenarios, MAX_PRICE_AGE, ok_json, err_json)
  else if str.starts_with(req.path, "/finance/state_at/") then qasim_http.state_at(req, db, qasim_prices, qasim_state, MAX_PRICE_AGE, ok_json, err_json)
  else if str.starts_with(req.path, "/finance/position/") then qasim_http.get_position(req, db, qasim_prices, qasim_state, ok_json)
  else { status: 404, headers: {}, body: "not found" } in
  let req_payload = json.canonicalize({ path: req.path, body: req.body }) in
  let req_digest = hash.sha256_text(req_payload) in
  let res_payload = json.canonicalize({ status: res.status, headers: res.headers, body: res.body }) in
  let res_digest = hash.sha256_text(res_payload) in
  let state_digest = if rec.has(res.headers, "Content-Type") && rec.get(res.headers, "Content-Type") == "application/json" then let body_obj = json.decode(res.body) in if rec.has(body_obj, "state_digest") then rec.get(body_obj, "state_digest") else "" else "" in
  let prev_rows = sqlite.query(db, "SELECT chain_digest FROM receipt_log ORDER BY seq DESC LIMIT 1") in
  let prev_hit = list.find(prev_rows, fn(_) { true }) in
  let prev_chain = if rec.has(prev_hit, "some") then prev_hit.some.chain_digest else "GENESIS" in
  let chain_payload = json.canonicalize({ prev_chain_digest: prev_chain, request_digest: req_digest, response_digest: res_digest, state_digest: state_digest }) in
  let chain_digest = hash.sha256_text(chain_payload) in
  let chain_sig = qasim_crypto.chain_sign(chain_secret_hex, chain_digest) in
  let chain_pk  = qasim_crypto.signer_id(chain_secret_hex) in
  let _ = sqlite.exec(db, str.concat([
    "INSERT INTO receipt_log (req_digest,res_digest,state_digest,chain_digest,payload_json) VALUES ('",
    req_digest, "'", ", '",
    res_digest, "'", ", '",
    state_digest, "'", ", '",
    chain_digest, "'", ", '",
    chain_payload, "')"
  ])) in
  {
    status: res.status,
    headers: rec.set(rec.set(rec.set(rec.set(rec.set(res.headers, "X-Qasim-Request-Digest", req_digest), "X-Qasim-Response-Digest", res_digest), "X-Qasim-Chain-Digest", chain_digest), "X-Qasim-Chain-Signature", chain_sig), "X-Qasim-Chain-Public-Key", chain_pk),
    body: res.body
  }
}

let _ = net.serve(9801, fn(req) { handle(req) })
