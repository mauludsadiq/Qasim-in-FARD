import("std/net")    as net
import("std/sqlite") as sqlite
import("std/json")   as json
import("std/str")    as str
import("std/list")   as list
import("std/rec")    as rec
import("std/hash")   as hash
import("std/bytes")  as bytes
import("std/base64") as b64
import("std/crypto") as crypto
import("./packages/qasim_crypto/main") as qasim_crypto
import("std/http")   as http
import("./packages/qasim_prices/main") as qasim_prices
import("./packages/qasim_state/main") as qasim_state
import("./packages/qasim_http/main") as qasim_http
import("./packages/qasim_scenarios/main") as qasim_scenarios
import("./packages/qasim_objects/main") as qasim_objects
import("std/env") as env
import("std/mutex") as mutex

let DB_PATH = "/tmp/qasim_fard.db"
let chain_secret_hex_opt = env.get("QASIM_CHAIN_SECRET_HEX")
let chain_secret_hex = if rec.has(chain_secret_hex_opt, "some") then chain_secret_hex_opt.some else ""
let _ = if chain_secret_hex == "" then error("QASIM_CHAIN_SECRET_HEX is not set") else null

let MAX_PRICE_AGE = 86400
let db = sqlite.open(DB_PATH)

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS tx (
  digest TEXT PRIMARY KEY,
  id TEXT NOT NULL,
  account TEXT NOT NULL,
  instrument TEXT NOT NULL,
  side TEXT NOT NULL,
  qty REAL NOT NULL,
  price REAL NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_tx_account ON tx(account)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS price_claims (
  digest TEXT PRIMARY KEY,
  symbol TEXT NOT NULL,
  mid REAL NOT NULL,
  venue TEXT NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_price_symbol_ts ON price_claims(symbol, ts_unix)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS api_keys (
  key_hash TEXT PRIMARY KEY,
  label TEXT NOT NULL,
  role TEXT NOT NULL,
  created_ts INTEGER NOT NULL,
  expiry_ts INTEGER NOT NULL DEFAULT 0,
  active INTEGER NOT NULL DEFAULT 1
)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS receipt_log (
  seq INTEGER PRIMARY KEY AUTOINCREMENT,
  req_digest TEXT NOT NULL,
  res_digest TEXT NOT NULL,
  state_digest TEXT NOT NULL,
  chain_digest TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_receipt_log_seq ON receipt_log(seq)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS cash_objects (
  digest TEXT PRIMARY KEY,
  account TEXT NOT NULL,
  currency TEXT NOT NULL,
  amount REAL NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_cash_account_ts ON cash_objects(account, ts_unix)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS orders (
  digest TEXT PRIMARY KEY,
  order_id TEXT NOT NULL,
  account TEXT NOT NULL,
  instrument TEXT NOT NULL,
  side TEXT NOT NULL,
  qty REAL NOT NULL,
  order_type TEXT NOT NULL,
  limit_price REAL,
  ts_unix INTEGER NOT NULL,
  filled_qty REAL NOT NULL DEFAULT 0,
  status TEXT NOT NULL DEFAULT 'open',
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_orders_account_ts ON orders(account, ts_unix)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS fills (
  digest TEXT PRIMARY KEY,
  fill_id TEXT NOT NULL,
  order_id TEXT NOT NULL,
  account TEXT NOT NULL,
  instrument TEXT NOT NULL,
  side TEXT NOT NULL,
  qty REAL NOT NULL,
  price REAL NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_fills_account_ts ON fills(account, ts_unix)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS object_store (
  digest TEXT PRIMARY KEY,
  object_type TEXT NOT NULL,
  account TEXT,
  instrument TEXT,
  ts_unix INTEGER,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_object_store_type_account_ts ON object_store(object_type, account, ts_unix)")

fn ok_json(v) {
  { status: 200, headers: { "Content-Type": "application/json" }, body: json.encode(v) }
}

fn err_json(status, msg) {
  { status: status, headers: { "Content-Type": "application/json" }, body: json.encode({ ok: false, error: msg }) }
}


let position_cache = mutex.new({})

let ctx = {
  db: db,
  max_price_age: MAX_PRICE_AGE,
  qasim_prices: qasim_prices,
  qasim_state: qasim_state,
  qasim_scenarios: qasim_scenarios,
  admin_key_hash: (let ak = env.get("QASIM_ADMIN_KEY_HASH") in if rec.has(ak, "some") then ak.some else ""),
  qasim_objects: qasim_objects,
  crypto: crypto,
  hash: hash,
  bytes: bytes,
  b64: b64,
  http: http,
  str: str,
  position_cache: position_cache,
  mutex: mutex
}

fn handle(req) {
  let res = qasim_http.handle(req, ctx) in
  let req_payload = json.canonicalize({ path: req.path, body: req.body }) in
  let req_digest = hash.sha256_text(req_payload) in
  let res_payload = json.canonicalize({ status: res.status, headers: res.headers, body: res.body }) in
  let res_digest = hash.sha256_text(res_payload) in
  let state_digest = if rec.has(res.headers, "Content-Type") && rec.get(res.headers, "Content-Type") == "application/json" then let body_obj = json.decode(res.body) in if rec.has(body_obj, "state_digest") then rec.get(body_obj, "state_digest") else "" else "" in
  let prev_rows = sqlite.query(db, "SELECT chain_digest FROM receipt_log ORDER BY seq DESC LIMIT 1") in
  let prev_hit = list.find(prev_rows, fn(_) { true }) in
  let prev_chain = if rec.has(prev_hit, "some") then prev_hit.some.chain_digest else "GENESIS" in
  let chain_payload = json.canonicalize({ prev_chain_digest: prev_chain, request_digest: req_digest, response_digest: res_digest, state_digest: state_digest }) in
  let chain_digest = hash.sha256_text(chain_payload) in
  let chain_sig = qasim_crypto.chain_sign(chain_secret_hex, chain_digest) in
  let chain_pk  = qasim_crypto.signer_id(chain_secret_hex) in
  let _ = sqlite.exec(db, str.concat([
    "INSERT INTO receipt_log (req_digest,res_digest,state_digest,chain_digest,payload_json) VALUES ('",
    req_digest, "'", ", '",
    res_digest, "'", ", '",
    state_digest, "'", ", '",
    chain_digest, "'", ", '",
    chain_payload, "')"
  ])) in
  {
    status: res.status,
    headers: rec.set(rec.set(rec.set(rec.set(rec.set(res.headers, "X-Qasim-Request-Digest", req_digest), "X-Qasim-Response-Digest", res_digest), "X-Qasim-Chain-Digest", chain_digest), "X-Qasim-Chain-Signature", chain_sig), "X-Qasim-Chain-Public-Key", chain_pk),
    body: res.body
  }
}

let _ = net.serve(9801, fn(req) { handle(req) })
