import("std/net")    as net
import("std/sqlite") as sqlite
import("std/json")   as json
import("std/str")    as str
import("std/list")   as list
import("std/rec")    as rec
import("std/hash")   as hash
import("std/bytes")  as bytes
import("std/base64") as b64
import("std/crypto") as crypto
import("./packages/qasim_crypto/main") as qasim_crypto
import("std/http")   as http
import("./packages/qasim_prices/main") as qasim_prices
import("./packages/qasim_state/main") as qasim_state
import("./packages/qasim_http/main") as qasim_http
import("./packages/qasim_scenarios/main") as qasim_scenarios
import("./packages/qasim_objects/main") as qasim_objects
import("std/env") as env

let DB_PATH = "/tmp/qasim_fard.db"
let chain_secret_hex = env.get("QASIM_CHAIN_SECRET_HEX")
let _ = if chain_secret_hex == "" then error("QASIM_CHAIN_SECRET_HEX is not set") else null

let MAX_PRICE_AGE = 300
let db = sqlite.open(DB_PATH)

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS tx (
  digest TEXT PRIMARY KEY,
  id TEXT NOT NULL,
  account TEXT NOT NULL,
  instrument TEXT NOT NULL,
  side TEXT NOT NULL,
  qty REAL NOT NULL,
  price REAL NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_tx_account ON tx(account)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS price_claims (
  digest TEXT PRIMARY KEY,
  symbol TEXT NOT NULL,
  mid REAL NOT NULL,
  venue TEXT NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_price_symbol_ts ON price_claims(symbol, ts_unix)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS receipt_log (
  seq INTEGER PRIMARY KEY AUTOINCREMENT,
  req_digest TEXT NOT NULL,
  res_digest TEXT NOT NULL,
  state_digest TEXT NOT NULL,
  chain_digest TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_receipt_log_seq ON receipt_log(seq)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS cash_objects (
  digest TEXT PRIMARY KEY,
  account TEXT NOT NULL,
  currency TEXT NOT NULL,
  amount REAL NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_cash_account_ts ON cash_objects(account, ts_unix)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS orders (
  digest TEXT PRIMARY KEY,
  order_id TEXT NOT NULL,
  account TEXT NOT NULL,
  instrument TEXT NOT NULL,
  side TEXT NOT NULL,
  qty REAL NOT NULL,
  order_type TEXT NOT NULL,
  limit_price REAL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_orders_account_ts ON orders(account, ts_unix)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS fills (
  digest TEXT PRIMARY KEY,
  fill_id TEXT NOT NULL,
  order_id TEXT NOT NULL,
  account TEXT NOT NULL,
  instrument TEXT NOT NULL,
  side TEXT NOT NULL,
  qty REAL NOT NULL,
  price REAL NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_fills_account_ts ON fills(account, ts_unix)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS object_store (
  digest TEXT PRIMARY KEY,
  object_type TEXT NOT NULL,
  account TEXT,
  instrument TEXT,
  ts_unix INTEGER,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_object_store_type_account_ts ON object_store(object_type, account, ts_unix)")

fn ok_json(v) {
  { status: 200, headers: { "Content-Type": "application/json" }, body: json.encode(v) }
}

fn err_json(status, msg) {
  { status: status, headers: { "Content-Type": "application/json" }, body: json.encode({ ok: false, error: msg }) }
}

fn health() {
  ok_json({ status: "ok" })
}

fn hex_digest(payload_json) {
  hash.sha256_text(payload_json)
}

fn verify_payload(pk_hex, sig_b64, payload_json) {
  if pk_hex == "DEV" then true
  else
    let msg_hex = bytes.to_hex(bytes.of_str(payload_json)) in
    let sig_hex = bytes.to_hex(b64.decode(sig_b64)) in
    crypto.ed25519_verify(pk_hex, msg_hex, sig_hex)
}

fn require_text(v, k) {
  if rec.has(v, k) then rec.get(v, k) else ""
}

fn require_num(v, k) {
  if rec.has(v, k) then rec.get(v, k) else 0
}

fn post_tx(req) {
  let tx = json.decode(req.body)
  let payload_json = require_text(tx, "payload_json")
  let issuer_pk_hex = require_text(tx, "issuer_pk_hex")
  let sig_b64 = require_text(tx, "sig_b64")

  if payload_json == "" then err_json(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json(400, "missing sig_b64")
  else if !verify_payload(issuer_pk_hex, sig_b64, payload_json) then err_json(401, "bad sig")
  else
    let d = hex_digest(payload_json) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR IGNORE INTO tx (digest,id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      d, "','",
      require_text(tx, "id"), "','",
      require_text(tx, "account"), "','",
      require_text(tx, "instrument"), "','",
      require_text(tx, "side"), "',",
      str.from(require_num(tx, "qty")), ",",
      str.from(require_num(tx, "price")), ",",
      str.from(require_num(tx, "ts_unix")), ",'",
      issuer_pk_hex, "','",
      sig_b64, "','",
      payload_json, "')"
    ])) in
    let _ = sqlite.exec(db, str.concat(["INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('", d, "'", ", 'price_claim', NULL, '", require_text(p, "symbol"), "',", str.from(require_num(p, "ts_unix")), ", '", issuer_pk_hex, "', '", sig_b64, "', '", payload_json, "'", ")"])) in
      ok_json({ digest: d })
}

fn post_cash(req) {
  let body = json.decode(req.body)
  let payload_json = require_text(body, "payload_json")
  let issuer_pk_hex = require_text(body, "issuer_pk_hex")
  let sig_b64 = require_text(body, "sig_b64")

  if payload_json == "" then err_json(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json(400, "missing sig_b64")
  else if !verify_payload(issuer_pk_hex, sig_b64, payload_json) then err_json(401, "bad sig")
  else
    let obj = qasim_objects.cash(
      require_text(body, "account"),
      require_text(body, "currency"),
      require_num(body, "amount"),
      require_num(body, "ts_unix"),
      issuer_pk_hex,
      sig_b64
    ) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR IGNORE INTO cash_objects (digest,account,currency,amount,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      obj.digest, "'", ", '",
      obj.payload.account, "'", ", '",
      obj.payload.currency, "'", ",",
      str.from(obj.payload.amount), ",",
      str.from(obj.payload.ts_unix), ", '",
      issuer_pk_hex, "'", ", '",
      sig_b64, "'", ", '",
      payload_json, "'", ")"
    ])) in
    let _ = sqlite.exec(db, str.concat(["INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('", obj.digest, "'", ", '", obj.object_type, "'", ", '", obj.payload.account, "'", ", NULL,", str.from(obj.payload.ts_unix), ", '", issuer_pk_hex, "'", ", '", sig_b64, "'", ", '", payload_json, "'", ")"])) in
      ok_json({ object_type: obj.object_type, digest: obj.digest })
}

