import("std/net")    as net
import("std/sqlite") as sqlite
import("std/json")   as json
import("std/str")    as str
import("std/list")   as list
import("std/rec")    as rec
import("std/hash")   as hash
import("std/bytes")  as bytes
import("std/base64") as b64
import("std/crypto") as crypto
import("std/http")   as http

let DB_PATH = "/tmp/qasim_fard.db"
let db = sqlite.open(DB_PATH)

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS tx (
  digest TEXT PRIMARY KEY,
  id TEXT NOT NULL,
  account TEXT NOT NULL,
  instrument TEXT NOT NULL,
  side TEXT NOT NULL,
  qty REAL NOT NULL,
  price REAL NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_tx_account ON tx(account)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS price_claims (
  digest TEXT PRIMARY KEY,
  symbol TEXT NOT NULL,
  mid REAL NOT NULL,
  venue TEXT NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_price_symbol_ts ON price_claims(symbol, ts_unix)")

fn ok_json(v) {
  { status: 200, headers: { "Content-Type": "application/json" }, body: json.encode(v) }
}

fn err_json(status, msg) {
  { status: status, headers: { "Content-Type": "application/json" }, body: json.encode({ ok: false, error: msg }) }
}

fn health() {
  ok_json({ status: "ok" })
}

fn hex_digest(payload_json) {
  hash.sha256_text(payload_json)
}

fn verify_payload(pk_hex, sig_b64, payload_json) {
  let msg_hex = bytes.to_hex(bytes.of_str(payload_json))
  let sig_hex = bytes.to_hex(b64.decode(sig_b64))
  crypto.ed25519_verify(pk_hex, msg_hex, sig_hex)
}

fn require_text(v, k) {
  if rec.has(v, k) then rec.get(v, k) else ""
}

fn require_num(v, k) {
  if rec.has(v, k) then rec.get(v, k) else 0
}

fn post_tx(req) {
  let tx = json.decode(req.body)
  let payload_json = require_text(tx, "payload_json")
  let issuer_pk_hex = require_text(tx, "issuer_pk_hex")
  let sig_b64 = require_text(tx, "sig_b64")

  if payload_json == "" then err_json(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json(400, "missing sig_b64")
  else if !verify_payload(issuer_pk_hex, sig_b64, payload_json) then err_json(401, "bad sig")
  else
    let d = hex_digest(payload_json) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR REPLACE INTO tx (digest,id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      d, "','",
      require_text(tx, "id"), "','",
      require_text(tx, "account"), "','",
      require_text(tx, "instrument"), "','",
      require_text(tx, "side"), "',",
      str.from(require_num(tx, "qty")), ",",
      str.from(require_num(tx, "price")), ",",
      str.from(require_num(tx, "ts_unix")), ",'",
      issuer_pk_hex, "','",
      sig_b64, "','",
      payload_json, "')"
    ])) in
    ok_json({ digest: d })
}

fn post_price(req) {
  let p = json.decode(req.body)
  let payload_json = require_text(p, "payload_json")
  let issuer_pk_hex = require_text(p, "issuer_pk_hex")
  let sig_b64 = require_text(p, "sig_b64")

  if payload_json == "" then err_json(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json(400, "missing sig_b64")
  else if !verify_payload(issuer_pk_hex, sig_b64, payload_json) then err_json(401, "bad sig")
  else
    let d = hex_digest(payload_json) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR REPLACE INTO price_claims (digest,symbol,mid,venue,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      d, "','",
      require_text(p, "symbol"), "',",
      str.from(require_num(p, "mid")), ",'",
      require_text(p, "venue"), "',",
      str.from(require_num(p, "ts_unix")), ",'",
      issuer_pk_hex, "','",
      sig_b64, "','",
      payload_json, "')"
    ])) in
    ok_json({ digest: d })
}

fn adapt_price(feed_type, src) {
  if feed_type == "simple_json" then
    { ok: true, mid: require_num(src, "mid"), ts_unix: require_num(src, "ts_unix") }
  else if feed_type == "coindesk" then
    if rec.has(src, "bpi") && rec.has(src.bpi, "USD") then
      { ok: true, mid: require_num(src.bpi.USD, "rate_float"), ts_unix: 0 }
    else
      { ok: false, error: "coindesk adapter missing bpi.USD.rate_float" }
  else
    { ok: false, error: str.concat(["unknown feed_type: ", feed_type]) }
}

fn post_live_price(req) {
  let body = json.decode(req.body)
  let symbol = require_text(body, "symbol")
  let venue = require_text(body, "venue")
  let url = require_text(body, "url")
  let feed_type = if rec.has(body, "feed_type") then rec.get(body, "feed_type") else "simple_json"

  if symbol == "" then err_json(400, "missing symbol")
  else if venue == "" then err_json(400, "missing venue")
  else if url == "" then err_json(400, "missing url")
  else
    let resp = http.get(url) in
    let src = json.decode(resp.body) in
    let adapted = adapt_price(feed_type, src) in
    if !adapted.ok then err_json(400, adapted.error)
    else if adapted.mid == 0 then err_json(400, "adapter produced mid=0")
    else if adapted.ts_unix == 0 && feed_type == "simple_json" then err_json(400, "adapter produced ts_unix=0")
    else
      let mid = adapted.mid in
      let ts_unix = adapted.ts_unix in
      let payload = { symbol: symbol, mid: mid, ts_unix: ts_unix, venue: venue } in
      let payload_json = json.canonicalize(payload) in
      let d = hex_digest(payload_json) in
      let source_body_digest = hash.sha256_text(resp.body) in
      let _ = sqlite.exec(db, str.concat([
        "INSERT OR REPLACE INTO price_claims (digest,symbol,mid,venue,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
        d, "'", ", '",
        symbol, "'", ",",
        str.from(mid), ", '",
        venue, "'", ",",
        str.from(ts_unix), ", 'LIVE_HTTP', '",
        source_body_digest, "'", ", '",
        payload_json, "')"
      ])) in
      ok_json({ digest: d, symbol: symbol, venue: venue, feed_type: feed_type, source_url: url, source_body_digest: source_body_digest, mid: mid, ts_unix: ts_unix })
}

fn latest_price_rows() {
  sqlite.query(db, "SELECT p1.symbol AS symbol, p1.mid AS mid, p1.ts_unix AS ts_unix
                    FROM price_claims p1
                    JOIN (
                      SELECT symbol, MAX(ts_unix) AS max_ts
                      FROM price_claims
                      GROUP BY symbol
                    ) p2
                    ON p1.symbol = p2.symbol AND p1.ts_unix = p2.max_ts
                    ORDER BY p1.symbol")
}

fn find_price(prices, symbol) {
  let hit = list.find(prices, fn(r) { r.symbol == symbol })
  if rec.has(hit, "some") then hit.some.mid else null
}

fn account_positions(account) {
  let rows = sqlite.query(db, str.concat([
    "SELECT instrument, side, qty FROM tx WHERE account='", account, "' ORDER BY instrument, ts_unix"
  ]))

  let qtys = list.fold(rows, {}, fn(acc, r) {
    let delta = if r.side == "buy" then r.qty else 0 - r.qty
    if rec.has(acc, r.instrument) then rec.set(acc, r.instrument, rec.get(acc, r.instrument) + delta)
    else rec.set(acc, r.instrument, delta)
  })

  let prices = latest_price_rows()
  let instruments = rec.keys(qtys)

  list.map(instruments, fn(inst) {
    let qty = rec.get(qtys, inst)
    let price = find_price(prices, str.concat([inst, "/USD"]))
    let value = if price == null then null else qty * price
    { instrument: inst, qty: qty, price: price, value: value }
  })
}

fn nav_of(positions) {
  list.fold(positions, 0, fn(acc, p) {
    if p.value == null then acc else acc + p.value
  })
}

fn positions_from_rows(tx_rows, price_rows) {
  let qtys = list.fold(tx_rows, {}, fn(acc, r) {
    let delta = if r.side == "buy" then r.qty else 0 - r.qty
    if rec.has(acc, r.instrument) then rec.set(acc, r.instrument, rec.get(acc, r.instrument) + delta)
    else rec.set(acc, r.instrument, delta)
  })

  let instruments = rec.keys(qtys)

  list.map(instruments, fn(inst) {
    let qty = rec.get(qtys, inst)
    let hit = list.find(price_rows, fn(p) { p.symbol == str.concat([inst, "/USD"]) })
    let price = if rec.has(hit, "some") then hit.some.mid else null
    let value = if price == null then null else qty * price
    { instrument: inst, qty: qty, price: price, value: value }
  })
}

fn state_receipt(account, positions) {
  let tx_rows = sqlite.query(db, str.concat([
    "SELECT digest FROM tx WHERE account='", account, "' ORDER BY ts_unix, digest"
  ]))
  let price_rows = sqlite.query(db, "SELECT digest FROM price_claims ORDER BY symbol, ts_unix, digest")
  let tx_digests = list.map(tx_rows, fn(r) { r.digest })
  let price_digests = list.map(price_rows, fn(r) { r.digest })
  let payload = {
    account: account,
    tx_digests: tx_digests,
    price_digests: price_digests,
    positions: positions,
    nav: nav_of(positions)
  }
  {
    state_digest: hash.sha256_text(json.encode(payload)),
    tx_count: list.len(tx_digests),
    price_count: list.len(price_digests)
  }
}

fn replay(req) {
  let body = json.decode(req.body)
  let account = if rec.has(body, "account") then rec.get(body, "account") else ""
  let tx_rows = if rec.has(body, "txs") then rec.get(body, "txs") else []
  let price_rows = if rec.has(body, "prices") then rec.get(body, "prices") else []
  let positions = positions_from_rows(tx_rows, price_rows)
  let payload = {
    account: account,
    tx_digests: list.map(tx_rows, fn(r) { if rec.has(r, "digest") then r.digest else hex_digest(r.payload_json) }),
    price_digests: list.map(price_rows, fn(r) { if rec.has(r, "digest") then r.digest else hex_digest(r.payload_json) }),
    positions: positions,
    nav: nav_of(positions)
  }
  ok_json({ account: account, positions: positions, nav: nav_of(positions), state_digest: hash.sha256_text(json.encode(payload)), tx_count: list.len(tx_rows), price_count: list.len(price_rows) })
}

fn get_position(req) {
  let prefix = "/finance/position/"
  let account = str.slice(req.path, str.len(prefix), str.len(req.path))
  let positions = account_positions(account)
  let receipt = state_receipt(account, positions)
  ok_json({ account: account, positions: positions, nav: nav_of(positions), state_digest: receipt.state_digest, tx_count: receipt.tx_count, price_count: receipt.price_count })
}

fn handle(req) {
  if req.path == "/health" then health()
  else if req.path == "/finance/ingest/tx" then post_tx(req)
  else if req.path == "/finance/price/claim" then post_price(req)
  else if req.path == "/finance/live/price" then post_live_price(req)
  else if req.path == "/finance/replay" then replay(req)
  else if str.starts_with(req.path, "/finance/position/") then get_position(req)
  else { status: 404, headers: {}, body: "not found" }
}

let _ = net.serve(9801, fn(req) { handle(req) })
