import("std/net")    as net
import("std/sqlite") as sqlite
import("std/json")   as json
import("std/str")    as str
import("std/list")   as list
import("std/rec")    as rec
import("std/hash")   as hash
import("std/bytes")  as bytes
import("std/base64") as b64
import("std/crypto") as crypto
import("std/http")   as http
import("./packages/qasim_prices/main") as qasim_prices
import("./packages/qasim_state/main") as qasim_state
import("./packages/qasim_http/main") as qasim_http

let DB_PATH = "/tmp/qasim_fard.db"
let MAX_PRICE_AGE = 300
let db = sqlite.open(DB_PATH)

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS tx (
  digest TEXT PRIMARY KEY,
  id TEXT NOT NULL,
  account TEXT NOT NULL,
  instrument TEXT NOT NULL,
  side TEXT NOT NULL,
  qty REAL NOT NULL,
  price REAL NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_tx_account ON tx(account)")

let _ = sqlite.exec(db, "CREATE TABLE IF NOT EXISTS price_claims (
  digest TEXT PRIMARY KEY,
  symbol TEXT NOT NULL,
  mid REAL NOT NULL,
  venue TEXT NOT NULL,
  ts_unix INTEGER NOT NULL,
  issuer_pk_hex TEXT NOT NULL,
  sig_b64 TEXT NOT NULL,
  payload_json TEXT NOT NULL
)")

let _ = sqlite.exec(db, "CREATE INDEX IF NOT EXISTS idx_price_symbol_ts ON price_claims(symbol, ts_unix)")

fn ok_json(v) {
  { status: 200, headers: { "Content-Type": "application/json" }, body: json.encode(v) }
}

fn err_json(status, msg) {
  { status: status, headers: { "Content-Type": "application/json" }, body: json.encode({ ok: false, error: msg }) }
}

fn health() {
  ok_json({ status: "ok" })
}

fn hex_digest(payload_json) {
  hash.sha256_text(payload_json)
}

fn verify_payload(pk_hex, sig_b64, payload_json) {
  let msg_hex = bytes.to_hex(bytes.of_str(payload_json))
  let sig_hex = bytes.to_hex(b64.decode(sig_b64))
  crypto.ed25519_verify(pk_hex, msg_hex, sig_hex)
}

fn require_text(v, k) {
  if rec.has(v, k) then rec.get(v, k) else ""
}

fn require_num(v, k) {
  if rec.has(v, k) then rec.get(v, k) else 0
}

fn post_tx(req) {
  let tx = json.decode(req.body)
  let payload_json = require_text(tx, "payload_json")
  let issuer_pk_hex = require_text(tx, "issuer_pk_hex")
  let sig_b64 = require_text(tx, "sig_b64")

  if payload_json == "" then err_json(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json(400, "missing sig_b64")
  else if !verify_payload(issuer_pk_hex, sig_b64, payload_json) then err_json(401, "bad sig")
  else
    let d = hex_digest(payload_json) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR REPLACE INTO tx (digest,id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      d, "','",
      require_text(tx, "id"), "','",
      require_text(tx, "account"), "','",
      require_text(tx, "instrument"), "','",
      require_text(tx, "side"), "',",
      str.from(require_num(tx, "qty")), ",",
      str.from(require_num(tx, "price")), ",",
      str.from(require_num(tx, "ts_unix")), ",'",
      issuer_pk_hex, "','",
      sig_b64, "','",
      payload_json, "')"
    ])) in
    ok_json({ digest: d })
}

fn post_price(req) {
  let p = json.decode(req.body)
  let payload_json = require_text(p, "payload_json")
  let issuer_pk_hex = require_text(p, "issuer_pk_hex")
  let sig_b64 = require_text(p, "sig_b64")

  if payload_json == "" then err_json(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json(400, "missing sig_b64")
  else if !verify_payload(issuer_pk_hex, sig_b64, payload_json) then err_json(401, "bad sig")
  else
    let d = hex_digest(payload_json) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR REPLACE INTO price_claims (digest,symbol,mid,venue,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      d, "','",
      require_text(p, "symbol"), "',",
      str.from(require_num(p, "mid")), ",'",
      require_text(p, "venue"), "',",
      str.from(require_num(p, "ts_unix")), ",'",
      issuer_pk_hex, "','",
      sig_b64, "','",
      payload_json, "')"
    ])) in
    ok_json({ digest: d })
}

fn adapt_price(feed_type, src) {
  if feed_type == "simple_json" then
    { ok: true, mid: require_num(src, "mid"), ts_unix: require_num(src, "ts_unix") }
  else if feed_type == "coindesk" then
    if rec.has(src, "bpi") && rec.has(src.bpi, "USD") then
      { ok: true, mid: require_num(src.bpi.USD, "rate_float"), ts_unix: 0 }
    else
      { ok: false, error: "coindesk adapter missing bpi.USD.rate_float" }
  else
    { ok: false, error: str.concat(["unknown feed_type: ", feed_type]) }
}

fn post_live_price(req) {
  let body = json.decode(req.body)
  let symbol = require_text(body, "symbol")
  let venue = require_text(body, "venue")
  let url = require_text(body, "url")
  let feed_type = if rec.has(body, "feed_type") then rec.get(body, "feed_type") else "simple_json"
  let issuer_pk_hex = require_text(body, "issuer_pk_hex")
  let signing_secret_hex = require_text(body, "signing_secret_hex")

  if symbol == "" then err_json(400, "missing symbol")
  else if venue == "" then err_json(400, "missing venue")
  else if url == "" then err_json(400, "missing url")
  else if issuer_pk_hex == "" then err_json(400, "missing issuer_pk_hex")
  else if signing_secret_hex == "" then err_json(400, "missing signing_secret_hex")
  else
    let resp = http.get(url) in
    let src = json.decode(resp.body) in
    let adapted = adapt_price(feed_type, src) in
    if !adapted.ok then err_json(400, adapted.error)
    else if adapted.mid == 0 then err_json(400, "adapter produced mid=0")
    else if adapted.ts_unix == 0 && feed_type == "simple_json" then err_json(400, "adapter produced ts_unix=0")
    else
      let mid = adapted.mid in
      let ts_unix = adapted.ts_unix in
      let payload = { symbol: symbol, mid: mid, ts_unix: ts_unix, venue: venue } in
      let payload_json = json.canonicalize(payload) in
      let d = hex_digest(payload_json) in
      let source_body_digest = hash.sha256_text(resp.body) in
      let receipt = {
        source_url: url,
        source_body_digest: source_body_digest,
        feed_type: feed_type,
        symbol: symbol,
        venue: venue,
        mid: mid,
        ts_unix: ts_unix
      } in
      let receipt_json = json.canonicalize(receipt) in
      let receipt_digest = hash.sha256_text(receipt_json) in
      let sig_hex = crypto.hmac_sha256(signing_secret_hex, receipt_json) in
      let sig_b64 = b64.encode(bytes.from_hex(sig_hex)) in
      let _ = sqlite.exec(db, str.concat([
        "INSERT OR REPLACE INTO price_claims (digest,symbol,mid,venue,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
        d, "','",
        symbol, "',",
        str.from(mid), ",'",
        venue, "',",
        str.from(ts_unix), ",'",
        issuer_pk_hex, "','",
        sig_b64, "','",
        payload_json, "')"
      ])) in
      ok_json({
        digest: d,
        symbol: symbol,
        venue: venue,
        feed_type: feed_type,
        source_url: url,
        source_body_digest: source_body_digest,
        receipt_digest: receipt_digest,
        receipt_json: receipt_json,
        issuer_pk_hex: issuer_pk_hex,
        sig_b64: sig_b64,
        mid: mid,
        ts_unix: ts_unix
      })
}

fn latest_price_rows() {
  sqlite.query(db, "SELECT symbol,mid,venue,ts_unix,digest,issuer_pk_hex,sig_b64,payload_json
                    FROM price_claims
                    ORDER BY symbol, ts_unix, digest")
}

fn price_rows_at(ts_unix_cutoff) {
  let rows = sqlite.query(db, str.concat([
    "SELECT symbol,mid,venue,ts_unix,digest,issuer_pk_hex,sig_b64,payload_json FROM price_claims WHERE ts_unix<=",
    str.from(ts_unix_cutoff),
    " ORDER BY symbol, ts_unix, digest"
  ]))
  list.filter(rows, fn(r) { (ts_unix_cutoff - r.ts_unix) <= MAX_PRICE_AGE })
}

fn aggregate_symbol_prices(price_rows, symbol) {
  let rows = list.filter(price_rows, fn(r) { r.symbol == symbol })
  let values = list.map(rows, fn(r) { r.mid })
  let n = list.len(values)
  if n == 0 then { symbol: symbol, median: null, mean: null, variance: null, outliers: [], sources: [] }
  else let sum = list.fold(values, 0, fn(acc, x) { acc + x }) in let mean = sum / n in let variance = list.fold(values, 0, fn(acc, x) { let d = x - mean in acc + (d * d) }) / n in let threshold = variance * 4 in let outliers = list.filter(rows, fn(r) { let d = r.mid - mean in (d * d) > threshold }) in { symbol: symbol, median: mean, mean: mean, variance: variance, outliers: outliers, sources: rows }
}

fn aggregate_all_prices(price_rows) {
  let symbols = rec.keys(list.fold(price_rows, {}, fn(acc, r) {
    if rec.has(acc, r.symbol) then acc else rec.set(acc, r.symbol, true)
  }))
  list.map(symbols, fn(sym) { aggregate_symbol_prices(price_rows, sym) })
}

fn consensus_price(price_rows, symbol) {
  let agg = aggregate_symbol_prices(price_rows, symbol)
  agg.median
}

fn price_aggregate(req) {
  let prefix = "/finance/price/aggregate/"
  let symbol = str.slice(req.path, str.len(prefix), str.len(req.path))
  let rows = latest_price_rows()
  ok_json(aggregate_symbol_prices(rows, symbol))
}

fn tx_rows_for_account(account) {
  sqlite.query(db, str.concat([
    "SELECT digest,id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json FROM tx WHERE account='",
    account,
    "' ORDER BY ts_unix, digest"
  ]))
}

fn tx_rows_for_account_at(account, ts_unix_cutoff) {
  sqlite.query(db, str.concat([
    "SELECT digest,id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json FROM tx WHERE account='",
    account,
    "' AND ts_unix<=",
    str.from(ts_unix_cutoff),
    " ORDER BY ts_unix, digest"
  ]))
}

fn find_price(prices, symbol) {
  consensus_price(prices, symbol)
}

fn positions_from_rows(tx_rows, price_rows) {
  let qtys = list.fold(tx_rows, {}, fn(acc, r) {
    let delta = if r.side == "buy" then r.qty else 0 - r.qty
    if rec.has(acc, r.instrument) then rec.set(acc, r.instrument, rec.get(acc, r.instrument) + delta)
    else rec.set(acc, r.instrument, delta)
  })

  let instruments = rec.keys(qtys)

  list.map(instruments, fn(inst) {
    let qty = rec.get(qtys, inst)
    let price = consensus_price(price_rows, str.concat([inst, "/USD"]))
    let value = if price == null then null else qty * price
    { instrument: inst, qty: qty, price: price, value: value }
  })
}

fn account_positions(account) {
  positions_from_rows(tx_rows_for_account(account), latest_price_rows())
}

fn account_positions_at(account, ts_unix_cutoff) {
  positions_from_rows(tx_rows_for_account_at(account, ts_unix_cutoff), price_rows_at(ts_unix_cutoff))
}

fn nav_of(positions) {
  list.fold(positions, 0, fn(acc, p) {
    if p.value == null then acc else acc + p.value
  })
}

fn state_receipt_from_rows(account, tx_rows, price_rows, positions, as_of_ts) {
  let tx_digests = list.map(tx_rows, fn(r) { r.digest })
  let price_digests = list.map(price_rows, fn(r) { r.digest })
  let payload = {
    account: account,
    as_of_ts: as_of_ts,
    tx_digests: tx_digests,
    price_digests: price_digests,
    positions: positions,
    nav: nav_of(positions)
  }
  {
    state_digest: hash.sha256_text(json.encode(payload)),
    tx_count: list.len(tx_digests),
    price_count: list.len(price_digests)
  }
}

fn state_receipt(account, positions) {
  state_receipt_from_rows(account, tx_rows_for_account(account), latest_price_rows(), positions, null)
}

fn state_receipt_at(account, ts_unix_cutoff, positions) {
  state_receipt_from_rows(account, tx_rows_for_account_at(account, ts_unix_cutoff), price_rows_at(ts_unix_cutoff), positions, ts_unix_cutoff)
}

fn replay(req) {
  let body = json.decode(req.body)
  let account = if rec.has(body, "account") then rec.get(body, "account") else ""
  let tx_rows = if rec.has(body, "txs") then rec.get(body, "txs") else []
  let price_rows = if rec.has(body, "prices") then rec.get(body, "prices") else []
  let as_of_ts = if rec.has(body, "as_of_ts") then rec.get(body, "as_of_ts") else null
  let tx_rows2 = if as_of_ts == null then tx_rows else list.filter(tx_rows, fn(r) { r.ts_unix <= as_of_ts })
  let price_rows2 = if as_of_ts == null then price_rows else list.filter(price_rows, fn(r) { r.ts_unix <= as_of_ts })
  let positions = positions_from_rows(tx_rows2, price_rows2)
  let payload = {
    account: account,
    as_of_ts: as_of_ts,
    tx_digests: list.map(tx_rows2, fn(r) { if rec.has(r, "digest") then r.digest else hex_digest(r.payload_json) }),
    price_digests: list.map(price_rows2, fn(r) { if rec.has(r, "digest") then r.digest else hex_digest(r.payload_json) }),
    positions: positions,
    nav: nav_of(positions)
  }
  ok_json({ account: account, as_of_ts: as_of_ts, positions: positions, nav: nav_of(positions), state_digest: hash.sha256_text(json.encode(payload)), tx_count: list.len(tx_rows2), price_count: list.len(price_rows2) })
}

fn get_position(req) {
  let prefix = "/finance/position/"
  let account = str.slice(req.path, str.len(prefix), str.len(req.path))
  let positions = account_positions(account)
  let receipt = state_receipt(account, positions)
  ok_json({ account: account, positions: positions, nav: nav_of(positions), state_digest: receipt.state_digest, tx_count: receipt.tx_count, price_count: receipt.price_count })
}

fn state_at(req) {
  let prefix = "/finance/state_at/"
  let rest = str.slice(req.path, str.len(prefix), str.len(req.path))
  let hit = list.find(str.split(rest, "/"), fn(_) { true })
  let parts = str.split(rest, "/")
  let account = if list.len(parts) > 0 then parts[0] else ""
  let ts_unix_cutoff = if list.len(parts) > 1 then parts[1] else ""
  if account == "" then err_json(400, "missing account")
  else if ts_unix_cutoff == "" then err_json(400, "missing ts_unix")
  else
    let cutoff = json.decode(str.concat([ts_unix_cutoff])) in
    let positions = account_positions_at(account, cutoff) in
    let receipt = state_receipt_at(account, cutoff, positions) in
    ok_json({ account: account, as_of_ts: cutoff, positions: positions, nav: nav_of(positions), state_digest: receipt.state_digest, tx_count: receipt.tx_count, price_count: receipt.price_count })
}

fn export_account(req) {
  let prefix = "/finance/export/"
  let account = str.slice(req.path, str.len(prefix), str.len(req.path))
  let txs = tx_rows_for_account(account)
  let prices = latest_price_rows()
  let positions = account_positions(account)
  let receipt = state_receipt(account, positions)
  ok_json({ account: account, txs: txs, prices: prices, positions: positions, nav: nav_of(positions), state_digest: receipt.state_digest, tx_count: receipt.tx_count, price_count: receipt.price_count })
}

fn export_account_at(req) {
  let prefix = "/finance/export_at/"
  let rest = str.slice(req.path, str.len(prefix), str.len(req.path))
  let parts = str.split(rest, "/")
  let account = if list.len(parts) > 0 then parts[0] else ""
  let ts_unix_cutoff = if list.len(parts) > 1 then parts[1] else ""
  if account == "" then err_json(400, "missing account")
  else if ts_unix_cutoff == "" then err_json(400, "missing ts_unix")
  else
    let cutoff = json.decode(str.concat([ts_unix_cutoff])) in
    let txs = tx_rows_for_account_at(account, cutoff) in
    let prices = price_rows_at(cutoff) in
    let positions = positions_from_rows(txs, prices) in
    let receipt = state_receipt_at(account, cutoff, positions) in
    ok_json({ account: account, as_of_ts: cutoff, txs: txs, prices: prices, positions: positions, nav: nav_of(positions), state_digest: receipt.state_digest, tx_count: receipt.tx_count, price_count: receipt.price_count })
}

fn handle(req) {
  if req.path == "/health" then health()
  else if req.path == "/finance/ingest/tx" then post_tx(req)
  else if req.path == "/finance/price/claim" then post_price(req)
  else if req.path == "/finance/live/price" then post_live_price(req)
  else if req.path == "/finance/replay" then qasim_http.replay(req, qasim_state, ok_json)
  else if str.starts_with(req.path, "/finance/price/aggregate/") then qasim_http.price_aggregate(req, db, qasim_prices, ok_json)
  else if str.starts_with(req.path, "/finance/export_at/") then qasim_http.export_account_at(req, db, qasim_prices, qasim_state, ok_json, err_json)
  else if str.starts_with(req.path, "/finance/export/") then qasim_http.export_account(req, db, qasim_prices, qasim_state, ok_json)
  else if str.starts_with(req.path, "/finance/state_at/") then qasim_http.state_at(req, db, qasim_prices, qasim_state, ok_json, err_json)
  else if str.starts_with(req.path, "/finance/position/") then qasim_http.get_position(req, db, qasim_prices, qasim_state, ok_json)
  else { status: 404, headers: {}, body: "not found" }
}

let _ = net.serve(9801, fn(req) { handle(req) })
