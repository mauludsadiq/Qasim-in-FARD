import("std/math") as math
import("std/cast") as cast
import("std/str") as str
import("std/list") as list
import("std/rec") as rec
import("std/hash") as hash
import("std/json") as json

fn value_position(qty, price, meta) {
  if price == null then null
  else if meta == null then qty * price
  else
    let asset_class = if rec.has(meta, "asset_class") then meta.asset_class else "equity" in
    let multiplier = if rec.has(meta, "multiplier") then meta.multiplier else 1 in
    if asset_class == "equity" then qty * price * multiplier
    else if asset_class == "future" then
      let initial_margin_rate = if rec.has(meta, "initial_margin_rate") then meta.initial_margin_rate else 0.05 in
      qty * price * multiplier * initial_margin_rate
    else if asset_class == "option" then qty * price * multiplier
    else if asset_class == "fixed_income" then qty * (price / 100) * multiplier
    else if asset_class == "fx" then qty * price
    else qty * price * multiplier
}

fn notional_position(qty, price, meta) {
  if price == null then null
  else if meta == null then qty * price
  else
    let asset_class = if rec.has(meta, "asset_class") then meta.asset_class else "equity" in
    let multiplier = if rec.has(meta, "multiplier") then meta.multiplier else 1 in
    if asset_class == "future" then qty * price * multiplier
    else null
}

fn mtm_pnl_of(qty, current_price, entry_price, meta) {
  if current_price == null || entry_price == null then 0.0
  else
    let asset_class = if meta == null then "equity" else if rec.has(meta, "asset_class") then meta.asset_class else "equity" in
    let multiplier = if meta == null then 1 else if rec.has(meta, "multiplier") then meta.multiplier else 1 in
    if asset_class == "future" then
      cast.float(qty) * (cast.float(current_price) - cast.float(entry_price)) * cast.float(multiplier)
    else 0.0
}

fn variation_margin_of(mtm_pnl) {
  if mtm_pnl > 0.0 then mtm_pnl else 0.0
}

fn initial_margin_of(qty, price, meta) {
  if price == null then 0.0
  else
    let asset_class = if meta == null then "equity" else if rec.has(meta, "asset_class") then meta.asset_class else "equity" in
    if asset_class != "future" then 0.0
    else
      let multiplier = if rec.has(meta, "multiplier") then meta.multiplier else 1 in
      let rate = if rec.has(meta, "initial_margin_rate") then meta.initial_margin_rate else 0.05 in
      cast.float(if qty < 0 then 0 - qty else qty) * cast.float(price) * cast.float(multiplier) * cast.float(rate)
}

fn price_symbol_for(inst, meta) {
  if meta == null then str.concat([inst, "/USD"])
  else
    let asset_class = if rec.has(meta, "asset_class") then meta.asset_class else "equity" in
    let symbol = if rec.has(meta, "symbol") then meta.symbol else inst in
    let currency = if rec.has(meta, "currency") then meta.currency else "USD" in
    if asset_class == "fx" then symbol
    else if currency == "USD" then str.concat([symbol, "/USD"])
    else str.concat([symbol, "/", currency])
}

fn positions_from_fills(fill_rows, price_rows, prices_mod) {
  positions_from_fills_with_meta(fill_rows, price_rows, prices_mod, [])
}

fn positions_from_fills_with_meta(fill_rows, price_rows, prices_mod, inst_rows) {
  let qtys = list.fold(fill_rows, {}, fn(acc, r) {
    let delta = if r.side == "buy" then r.qty else 0 - r.qty
    if rec.has(acc, r.instrument) then rec.set(acc, r.instrument, rec.get(acc, r.instrument) + delta)
    else rec.set(acc, r.instrument, delta)
  })

  let instruments = rec.keys(qtys)

  list.map(instruments, fn(inst) {
    let qty = rec.get(qtys, inst) in
    let hit = list.find(inst_rows, fn(r) { r.instrument_id == inst }) in
    let meta = if rec.has(hit, "some") then hit.some else null in
    let sym = price_symbol_for(inst, meta) in
    let price = prices_mod.consensus_price(price_rows, sym) in
    let value = value_position(qty, price, meta) in
    let asset_class = if meta == null then "equity" else if rec.has(meta, "asset_class") then meta.asset_class else "equity" in
    let inst_fills = list.filter(fill_rows, fn(f) { f.instrument == inst }) in
    let entry_price = if asset_class == "future" then
      let buy_fills = list.filter(inst_fills, fn(f) { f.side == "buy" }) in
      let total_cost = list.fold(buy_fills, 0.0, fn(acc, f) { acc + cast.float(f.qty) * cast.float(f.price) }) in
      let total_qty = list.fold(buy_fills, 0.0, fn(acc, f) { acc + cast.float(f.qty) }) in
      if total_qty == 0.0 then price else total_cost / total_qty
    else null in
    let notional = if asset_class == "future" then notional_position(qty, price, meta) else null in
    let mtm_pnl = if asset_class == "future" then mtm_pnl_of(qty, price, entry_price, meta) else null in
    let var_margin = if asset_class == "future" then variation_margin_of(if mtm_pnl == null then 0.0 else mtm_pnl) else null in
    let init_margin = if asset_class == "future" then initial_margin_of(qty, price, meta) else null in
    let expiry_ts = if meta != null && rec.has(meta, "expiry_ts_unix") then meta.expiry_ts_unix else null in
    { instrument: inst, qty: qty, price: price, value: value, asset_class: asset_class, notional: notional, entry_price: entry_price, mtm_pnl: mtm_pnl, variation_margin: var_margin, initial_margin: init_margin, expiry_ts: expiry_ts }
  })
}

fn cash_balance_of(cash_rows) {
  list.fold(cash_rows, 0, fn(acc, r) { acc + r.amount })
}

fn nav_of(positions, cash_balance) {
  cash_balance + list.fold(positions, 0, fn(acc, p) {
    if p.value == null then acc else acc + p.value
  })
}

fn effective_exposure_of(p) {
  let asset_class = if rec.has(p, "asset_class") then p.asset_class else "equity" in
  if asset_class == "option" then
    let greeks = if rec.has(p, "greeks") then p.greeks else null in
    if greeks == null then p.value
    else
      let delta = if rec.has(greeks, "delta") then greeks.delta else null in
      if delta == null then p.value
      else
        let price = if rec.has(p, "price") then p.price else null in
        if price == null then p.value
        else cast.float(price) * delta
  else p.value
}

fn gross_exposure_of(positions) {
  list.fold(positions, 0.0, fn(acc, p) {
    let v = effective_exposure_of(p) in
    if v == null then acc
    else if v < 0.0 then acc + (0.0 - v)
    else acc + v
  })
}

fn net_exposure_of(positions) {
  list.fold(positions, 0.0, fn(acc, p) {
    let v = effective_exposure_of(p) in
    if v == null then acc else acc + v
  })
}

fn long_exposure_of(positions) {
  list.fold(positions, 0.0, fn(acc, p) {
    let v = effective_exposure_of(p) in
    if v == null then acc
    else if v > 0.0 then acc + v
    else acc
  })
}

fn short_exposure_of(positions) {
  list.fold(positions, 0.0, fn(acc, p) {
    let v = effective_exposure_of(p) in
    if v == null then acc
    else if v < 0.0 then acc + (0.0 - v)
    else acc
  })
}

fn weight_of(value, gross) {
  if value == null then null
  else if gross == 0 then 0
  else cast.float(value) / gross
}

fn max_abs_weight_of(items) {
  list.fold(items, 0, fn(acc, x) {
    let v = if x.weight == null then 0 else if x.weight < 0 then 0 - x.weight else x.weight
    if v > acc then v else acc
  })
}


fn ncdf(x) {
  let pi = 3.141592653589793 in
  let neg = x < 0.0 in
  let ax = if neg then 0.0 - x else x in
  let t = 1.0 / (1.0 + 0.2316419 * ax) in
  let nd = math.exp(0.0 - (ax * ax) / 2.0) / math.sqrt(2.0 * pi) in
  let poly = t * (0.319381530 + t * (0.0 - 0.356563782 + t * (1.781477937 + t * (0.0 - 1.821255978 + t * 1.330274429)))) in
  let result = 1.0 - nd * poly in
  if neg then 1.0 - result else result
}

fn npdf(x) {
  let pi = 3.141592653589793 in
  math.exp(0.0 - (x * x) / 2.0) / math.sqrt(2.0 * pi)
}

fn black_scholes_greeks(spot, strike, vol, risk_free_rate, time_to_expiry, option_type) {
  if spot == null || strike == null || vol == null || time_to_expiry == null then
    { delta: null, gamma: null, vega: null, theta: null, rho: null, d1: null, d2: null }
  else if time_to_expiry <= 0.0 || vol <= 0.0 || spot <= 0.0 || strike <= 0.0 then
    { delta: null, gamma: null, vega: null, theta: null, rho: null, d1: null, d2: null }
  else
    let r = if risk_free_rate == null then 0.0 else risk_free_rate in
    let sqrt_t = math.sqrt(time_to_expiry) in
    let d1 = (math.log(spot / strike) + (r + vol * vol / 2.0) * time_to_expiry) / (vol * sqrt_t) in
    let d2 = d1 - vol * sqrt_t in
    let nd1 = ncdf(d1) in
    let nd2 = ncdf(d2) in
    let npd1 = npdf(d1) in
    let discount = math.exp(0.0 - r * time_to_expiry) in
    let is_call = option_type == "call" in
    let delta = if is_call then nd1 else nd1 - 1.0 in
    let gamma = npd1 / (spot * vol * sqrt_t) in
    let vega = spot * npd1 * sqrt_t / 100.0 in
    let theta = if is_call then
      (0.0 - spot * npd1 * vol / (2.0 * sqrt_t) - r * strike * discount * nd2) / 365.0
    else
      (0.0 - spot * npd1 * vol / (2.0 * sqrt_t) + r * strike * discount * (1.0 - nd2)) / 365.0 in
    let rho = if is_call then
      strike * time_to_expiry * discount * nd2 / 100.0
    else
      0.0 - strike * time_to_expiry * discount * (1.0 - nd2) / 100.0 in
    { delta: delta, gamma: gamma, vega: vega, theta: theta, rho: rho, d1: d1, d2: d2 }
}

fn position_greeks(p, meta, spot_price, as_of_ts) {
  if meta == null then null
  else
    let asset_class = if rec.has(meta, "asset_class") then meta.asset_class else "equity" in
    if asset_class != "option" then null
    else
      let strike = if rec.has(meta, "strike") then meta.strike else null in
      let vol = if rec.has(meta, "implied_vol") then meta.implied_vol else null in
      let expiry = if rec.has(meta, "expiry_ts_unix") then meta.expiry_ts_unix else 0 in
      let option_type = if rec.has(meta, "option_type") then meta.option_type else "call" in
      let rfr = if rec.has(meta, "risk_free_rate") then meta.risk_free_rate else 0.0 in
      let now_ts = if as_of_ts == null then 0 else as_of_ts in
      let secs_to_expiry = expiry - now_ts in
      let time_to_expiry = cast.float(secs_to_expiry) / 31536000.0 in
      let spot = if spot_price == null then null else cast.float(spot_price) in
      let k = if strike == null then null else cast.float(strike) in
      let greeks = black_scholes_greeks(spot, k, vol, rfr, time_to_expiry, option_type) in
      let qty = if rec.has(p, "qty") then p.qty else 0 in
      let multiplier = if rec.has(meta, "multiplier") then meta.multiplier else 1 in
      {
        delta: if greeks.delta == null then null else greeks.delta * cast.float(qty) * cast.float(multiplier),
        gamma: if greeks.gamma == null then null else greeks.gamma * cast.float(qty) * cast.float(multiplier),
        vega: if greeks.vega == null then null else greeks.vega * cast.float(qty) * cast.float(multiplier),
        theta: if greeks.theta == null then null else greeks.theta * cast.float(qty) * cast.float(multiplier),
        rho: if greeks.rho == null then null else greeks.rho * cast.float(qty) * cast.float(multiplier),
        unit_greeks: greeks
      }
}


fn dcf_nav_of(cash_flows, discount_rate, as_of_ts) {
  let r = if discount_rate == null then 0.08 else discount_rate in
  list.fold(cash_flows, 0.0, fn(acc, cf) {
    let secs = cf.expected_ts - as_of_ts in
    if secs <= 0 then acc
    else
      let t = cast.float(secs) / 31536000.0 in
      let flow_type = if rec.has(cf, "flow_type") then cf.flow_type else "distribution" in
      let amount = if rec.has(cf, "amount") then cf.amount else 0 in
      let pv = cast.float(amount) / math.exp(r * t) in
      if flow_type == "capital_call" then acc - pv
      else acc + pv
  })
}

fn private_nav_summary(cash_flows, discount_rate, as_of_ts) {
  let r = if discount_rate == null then 0.08 else discount_rate in
  let by_type = list.fold(cash_flows, { distributions: 0.0, capital_calls: 0.0, fees: 0.0, total_nav: 0.0, flow_count: 0 }, fn(acc, cf) {
    let secs = cf.expected_ts - as_of_ts in
    if secs <= 0 then acc
    else
      let t = cast.float(secs) / 31536000.0 in
      let flow_type = if rec.has(cf, "flow_type") then cf.flow_type else "distribution" in
      let amount = if rec.has(cf, "amount") then cf.amount else 0 in
      let pv = cast.float(amount) / math.exp(r * t) in
      if flow_type == "capital_call" then
        { distributions: acc.distributions, capital_calls: acc.capital_calls + pv, fees: acc.fees, total_nav: acc.total_nav - pv, flow_count: acc.flow_count + 1 }
      else if flow_type == "fee" then
        { distributions: acc.distributions, capital_calls: acc.capital_calls, fees: acc.fees + pv, total_nav: acc.total_nav - pv, flow_count: acc.flow_count + 1 }
      else
        { distributions: acc.distributions + pv, capital_calls: acc.capital_calls, fees: acc.fees, total_nav: acc.total_nav + pv, flow_count: acc.flow_count + 1 }
  }) in
  { nav: by_type.total_nav, pv_distributions: by_type.distributions, pv_capital_calls: by_type.capital_calls, pv_fees: by_type.fees, flow_count: by_type.flow_count, discount_rate: r, as_of_ts: as_of_ts }
}


fn matrix_get(mat, i, j) {
  let row = mat[i] in
  row[j]
}

fn matrix_set_row(mat, i, new_row) {
  list.map(list.range(0, list.len(mat)), fn(idx) {
    if idx == i then new_row else mat[idx]
  })
}

fn row_set(row, j, val) {
  list.map(list.range(0, list.len(row)), fn(idx) {
    if idx == j then val else row[idx]
  })
}

fn cholesky(cov_matrix, n) {
  let zero_row = list.map(list.range(0, n), fn(_) { 0.0 }) in
  let L = list.map(list.range(0, n), fn(_) { list.map(list.range(0, n), fn(_) { 0.0 }) }) in
  list.fold(list.range(0, n), L, fn(L_acc, i) {
    list.fold(list.range(0, i + 1), L_acc, fn(L2, j) {
      let sum_k = list.fold(list.range(0, j), 0.0, fn(s, k) {
        s + matrix_get(L2, i, k) * matrix_get(L2, j, k)
      }) in
      let cov_ij = matrix_get(cov_matrix, i, j) in
      let new_val = if i == j then
        let diag = cov_ij - sum_k in
        if diag <= 0.0 then 0.0 else math.sqrt(diag)
      else
        let ljj = matrix_get(L2, j, j) in
        if ljj == 0.0 then 0.0 else (cov_ij - sum_k) / ljj
      in
      let old_row = L2[i] in
      let new_row = row_set(old_row, j, new_val) in
      matrix_set_row(L2, i, new_row)
    })
  })
}

fn build_cov_matrix(positions, price_rows) {
  let n = list.len(positions) in
  let pos_returns = list.map(positions, fn(p) {
    let sym = price_symbol_for(p.instrument, null) in
    let rets = returns_from_prices(price_rows, sym) in
    let rets252 = if list.len(rets) > 252 then list.drop(rets, list.len(rets) - 252) else rets in
    { instrument: p.instrument, value: cast.float(if p.value == null then 0 else p.value), returns: rets252 }
  }) in
  list.map(list.range(0, n), fn(i) {
    let pi = pos_returns[i] in
    list.map(list.range(0, n), fn(j) {
      let pj = pos_returns[j] in
      let aligned = align_returns(pi.returns, pj.returns, 252) in
      if aligned.n < 2 then 0.0 else covariance_of(aligned.xs, aligned.ys)
    })
  })
}

fn mc_cholesky_var(positions, price_rows, n_sims, seed) {
  let n = list.len(positions) in
  if n == 0 then { mc_var_95: 0.0, mc_var_99: 0.0, n_sims: n_sims, seed: seed, method: "cholesky" }
  else
    let weights = list.map(positions, fn(p) {
      cast.float(if p.value == null then 0 else p.value)
    }) in
    let cov_matrix = build_cov_matrix(positions, price_rows) in
    let L = cholesky(cov_matrix, n) in
    let sim_range = list.range(0, n_sims) in
    let result = list.fold(sim_range, { state: seed, pnls: [] }, fn(acc, _) {
      let z_result = list.fold(list.range(0, n), { state: acc.state, zs: [] }, fn(zacc, _) {
        let r = lcg_normal(zacc.state) in
        { state: r.state, zs: list.append(zacc.zs, r.value) }
      }) in
      let corr_result = list.fold(list.range(0, n), { pnl: 0.0 }, fn(cacc, i) {
        let corr_i = list.fold(list.range(0, i + 1), 0.0, fn(s, j) {
          s + matrix_get(L, i, j) * z_result.zs[j]
        }) in
        let wi = weights[i] in
        { pnl: cacc.pnl + wi * corr_i }
      }) in
      { state: z_result.state, pnls: list.append(acc.pnls, corr_result.pnl) }
    }) in
    let sorted = list.sort_by(result.pnls, fn(a, b) {
      if a < b then 0 - 1 else if a > b then 1 else 0
    }) in
    let idx_95 = n_sims * 5 / 100 in
    let idx_99 = n_sims * 1 / 100 in
    let loss_95 = sorted[if idx_95 < 1 then 1 else idx_95] in
    let loss_99 = sorted[if idx_99 < 1 then 1 else idx_99] in
    let mc_var_95 = if loss_95 < 0.0 then 0.0 - loss_95 else 0.0 in
    let mc_var_99 = if loss_99 < 0.0 then 0.0 - loss_99 else 0.0 in
    { mc_var_95: mc_var_95, mc_var_99: mc_var_99, n_sims: n_sims, seed: seed, method: "cholesky" }
}


fn lcg_chi2(state, nu) {
  let result = list.fold(list.range(0, nu), { state: state, sum: 0.0 }, fn(acc, _) {
    let r = lcg_normal(acc.state) in
    { state: r.state, sum: acc.sum + r.value * r.value }
  }) in
  { state: result.state, value: result.sum }
}

fn lcg_student_t(state, nu) {
  let z = lcg_normal(state) in
  let chi2 = lcg_chi2(z.state, nu) in
  let denom = math.sqrt(chi2.value / cast.float(nu)) in
  let t = if denom == 0.0 then 0.0 else z.value / denom in
  { state: chi2.state, value: t }
}

fn mc_cholesky_t_var(positions, price_rows, n_sims, seed, nu) {
  let n = list.len(positions) in
  if n == 0 then { mc_var_95: 0.0, mc_var_99: 0.0, n_sims: n_sims, seed: seed, method: "cholesky_t", nu: nu }
  else
    let weights = list.map(positions, fn(p) {
      cast.float(if p.value == null then 0 else p.value)
    }) in
    let cov_matrix = build_cov_matrix(positions, price_rows) in
    let L = cholesky(cov_matrix, n) in
    let sim_range = list.range(0, n_sims) in
    let result = list.fold(sim_range, { state: seed, pnls: [] }, fn(acc, _) {
      let z_result = list.fold(list.range(0, n), { state: acc.state, zs: [] }, fn(zacc, _) {
        let r = lcg_student_t(zacc.state, nu) in
        { state: r.state, zs: list.append(zacc.zs, r.value) }
      }) in
      let corr_result = list.fold(list.range(0, n), { pnl: 0.0 }, fn(cacc, i) {
        let corr_i = list.fold(list.range(0, i + 1), 0.0, fn(s, j) {
          s + matrix_get(L, i, j) * z_result.zs[j]
        }) in
        { pnl: cacc.pnl + weights[i] * corr_i }
      }) in
      { state: z_result.state, pnls: list.append(acc.pnls, corr_result.pnl) }
    }) in
    let sorted = list.sort_by(result.pnls, fn(a, b) {
      if a < b then 0 - 1 else if a > b then 1 else 0
    }) in
    let idx_95 = n_sims * 5 / 100 in
    let idx_99 = n_sims * 1 / 100 in
    let loss_95 = sorted[if idx_95 < 1 then 1 else idx_95] in
    let loss_99 = sorted[if idx_99 < 1 then 1 else idx_99] in
    let mc_var_95 = if loss_95 < 0.0 then 0.0 - loss_95 else 0.0 in
    let mc_var_99 = if loss_99 < 0.0 then 0.0 - loss_99 else 0.0 in
    { mc_var_95: mc_var_95, mc_var_99: mc_var_99, n_sims: n_sims, seed: seed, method: "cholesky_t", nu: nu }
}


fn bond_cash_flows(face_value, coupon_rate, coupon_frequency, maturity_ts, as_of_ts) {
  let periods_per_year = if coupon_frequency == 0 then 2 else coupon_frequency in
  let coupon = cast.float(face_value) * cast.float(coupon_rate) / cast.float(periods_per_year) in
  let secs_per_period = cast.float(31536000) / cast.float(periods_per_year) in
  let secs_to_maturity = cast.float(maturity_ts - as_of_ts) in
  let n_periods = cast.float(cast.int(secs_to_maturity / secs_per_period)) in
  let n = if n_periods < 1.0 then 1 else cast.int(n_periods) in
  let coupon_flows = list.map(list.range(1, n), fn(i) {
    { t: cast.float(i) / cast.float(periods_per_year), cf: coupon }
  }) in
  let final_flow = { t: cast.float(n) / cast.float(periods_per_year), cf: coupon + cast.float(face_value) } in
  list.append(coupon_flows, final_flow)
}

fn discount_factor(ytm, m, t) {
  let r = cast.float(ytm) / cast.float(m) in
  let n = t * cast.float(m) in
  math.exp(0.0 - n * math.log(1.0 + r))
}

fn bond_price_from_ytm(face_value, coupon_rate, coupon_frequency, maturity_ts, ytm, as_of_ts) {
  let flows = bond_cash_flows(face_value, coupon_rate, coupon_frequency, maturity_ts, as_of_ts) in
  let m = if coupon_frequency == 0 then 2 else coupon_frequency in
  list.fold(flows, 0.0, fn(acc, f) {
    acc + f.cf * discount_factor(ytm, m, f.t)
  })
}

fn macaulay_duration(face_value, coupon_rate, coupon_frequency, maturity_ts, ytm, as_of_ts) {
  let flows = bond_cash_flows(face_value, coupon_rate, coupon_frequency, maturity_ts, as_of_ts) in
  let m = if coupon_frequency == 0 then 2 else coupon_frequency in
  let price = list.fold(flows, 0.0, fn(acc, f) {
    acc + f.cf * discount_factor(ytm, m, f.t)
  }) in
  if price == 0.0 then 0.0
  else
    let weighted = list.fold(flows, 0.0, fn(acc, f) {
      acc + f.t * f.cf * discount_factor(ytm, m, f.t)
    }) in
    weighted / price
}

fn modified_duration(face_value, coupon_rate, coupon_frequency, maturity_ts, ytm, as_of_ts) {
  let mac_dur = macaulay_duration(face_value, coupon_rate, coupon_frequency, maturity_ts, ytm, as_of_ts) in
  let m = if coupon_frequency == 0 then 2.0 else cast.float(coupon_frequency) in
  mac_dur / (1.0 + cast.float(ytm) / m)
}

fn bond_convexity(face_value, coupon_rate, coupon_frequency, maturity_ts, ytm, as_of_ts) {
  let flows = bond_cash_flows(face_value, coupon_rate, coupon_frequency, maturity_ts, as_of_ts) in
  let m = if coupon_frequency == 0 then 2 else coupon_frequency in
  let price = list.fold(flows, 0.0, fn(acc, f) {
    acc + f.cf * discount_factor(ytm, m, f.t)
  }) in
  if price == 0.0 then 0.0
  else
    let weighted = list.fold(flows, 0.0, fn(acc, f) {
      acc + f.t * (f.t + 1.0 / cast.float(m)) * f.cf * discount_factor(ytm, m, f.t)
    }) in
    weighted / (price * (1.0 + cast.float(ytm) / cast.float(m)) * (1.0 + cast.float(ytm) / cast.float(m)))
}

fn dv01_of(face_value, coupon_rate, coupon_frequency, maturity_ts, ytm, qty, multiplier, as_of_ts) {
  let mod_dur = modified_duration(face_value, coupon_rate, coupon_frequency, maturity_ts, ytm, as_of_ts) in
  let price = bond_price_from_ytm(face_value, coupon_rate, coupon_frequency, maturity_ts, ytm, as_of_ts) in
  let notional = cast.float(qty) * price * cast.float(multiplier) / 100.0 in
  0.0 - mod_dur * notional * 0.0001
}

fn bond_ir_risk(meta, qty, price, as_of_ts) {
  if meta == null then null
  else if !rec.has(meta, "coupon_rate") then null
  else
    let face_value = if rec.has(meta, "face_value") then meta.face_value else 100 in
    let coupon_rate = meta.coupon_rate in
    let coupon_freq = if rec.has(meta, "coupon_frequency") then meta.coupon_frequency else 2 in
    let maturity_ts = if rec.has(meta, "expiry_ts_unix") then meta.expiry_ts_unix else 0 in
    let ytm = if rec.has(meta, "ytm") then meta.ytm else coupon_rate in
    let multiplier = if rec.has(meta, "multiplier") then meta.multiplier else 1 in
    if maturity_ts == 0 || maturity_ts <= as_of_ts then null
    else
      let mac_dur = macaulay_duration(face_value, coupon_rate, coupon_freq, maturity_ts, ytm, as_of_ts) in
      let mod_dur = modified_duration(face_value, coupon_rate, coupon_freq, maturity_ts, ytm, as_of_ts) in
      let convexity = bond_convexity(face_value, coupon_rate, coupon_freq, maturity_ts, ytm, as_of_ts) in
      let dv01 = dv01_of(face_value, coupon_rate, coupon_freq, maturity_ts, ytm, qty, multiplier, as_of_ts) in
      let clean_price = if price != null then price else bond_price_from_ytm(face_value, coupon_rate, coupon_freq, maturity_ts, ytm, as_of_ts) in
      { macaulay_duration: mac_dur, modified_duration: mod_dur, convexity: convexity, dv01: dv01, ytm: ytm, coupon_rate: coupon_rate, face_value: face_value, clean_price: clean_price }
}


fn lcg_next(state) {
  let a = 6364136223846793005 in
  let c = 1442695040888963407 in
  let next = state * a + c in
  if next < 0 then 0 - next else next
}

fn lcg_float(state) {
  let next = lcg_next(state) in
  let f = cast.float(next) / 9223372036854775807.0 in
  { state: next, value: f }
}

fn lcg_normal(state) {
  let r1 = lcg_float(state) in
  let r2 = lcg_float(r1.state) in
  let u1 = if r1.value == 0.0 then 0.0000001 else r1.value in
  let n = math.sqrt(0.0 - 2.0 * math.log(u1)) * math.cos(2.0 * 3.141592653589793 * r2.value) in
  { state: r2.state, value: n }
}

fn mc_portfolio_var(positions, price_rows, n_sims, seed) {
  let pos_vols = list.map(positions, fn(p) {
    let sym = price_symbol_for(p.instrument, null) in
    let rets = returns_from_prices(price_rows, sym) in
    let vol = stddev_of(rets) in
    let value = if p.value == null then 0.0 else cast.float(p.value) in
    { instrument: p.instrument, value: value, vol: if vol == null then 0.0 else vol }
  }) in
  let sim_range = list.range(0, n_sims) in
  let result = list.fold(sim_range, { state: seed, pnls: [] }, fn(acc, _) {
    let pos_result = list.fold(pos_vols, { state: acc.state, pnl: 0.0 }, fn(pacc, pv) {
      if pv.vol == 0.0 then pacc
      else
        let r = lcg_normal(pacc.state) in
        { state: r.state, pnl: pacc.pnl + pv.value * pv.vol * r.value }
    }) in
    { state: pos_result.state, pnls: list.append(acc.pnls, pos_result.pnl) }
  }) in
  let sorted = list.sort_by(result.pnls, fn(a, b) {
    if a < b then 0 - 1 else if a > b then 1 else 0
  }) in
  let idx_95 = n_sims * 5 / 100 in
  let idx_99 = n_sims * 1 / 100 in
  let loss_95 = sorted[if idx_95 < 1 then 1 else idx_95] in
  let loss_99 = sorted[if idx_99 < 1 then 1 else idx_99] in
  let mc_var_95 = if loss_95 < 0.0 then 0.0 - loss_95 else 0.0 in
  let mc_var_99 = if loss_99 < 0.0 then 0.0 - loss_99 else 0.0 in
  { mc_var_95: mc_var_95, mc_var_99: mc_var_99, n_sims: n_sims, seed: seed }
}


fn mean_of(values) {
  let n = list.len(values) in
  if n == 0 then 0.0
  else
    let sum = list.fold(values, 0.0, fn(acc, x) { acc + x }) in
    sum / cast.float(n)
}

fn covariance_of(xs, ys) {
  let n = list.len(xs) in
  let m = list.len(ys) in
  if n < 2 || m < 2 || n != m then null
  else
    let mx = mean_of(xs) in
    let my = mean_of(ys) in
    let pairs = list.fold(xs, { i: 0, sum: 0.0 }, fn(acc, x) {
      let y = ys[acc.i] in
      { i: acc.i + 1, sum: acc.sum + (x - mx) * (y - my) }
    }) in
    pairs.sum / cast.float(n - 1)
}

fn align_returns(xs, ys, max_n) {
  let nx = list.len(xs) in
  let ny = list.len(ys) in
  let n = if nx < ny then nx else ny in
  let n2 = if n > max_n then max_n else n in
  let xs2 = list.drop(xs, nx - n2) in
  let ys2 = list.drop(ys, ny - n2) in
  { xs: xs2, ys: ys2, n: n2 }
}

fn portfolio_covar_var(positions, price_rows, z_score) {
  let n = list.len(positions) in
  if n == 0 then 0.0
  else
    let pos_returns = list.map(positions, fn(p) {
      let sym = price_symbol_for(p.instrument, null) in
      let rets = returns_from_prices(price_rows, sym) in
      let rets252 = if list.len(rets) > 252 then list.drop(rets, list.len(rets) - 252) else rets in
      { instrument: p.instrument, value: p.value, returns: rets252 }
    }) in
    let variance = list.fold(pos_returns, 0.0, fn(row_acc, pi) {
      if pi.value == null then row_acc
      else
        list.fold(pos_returns, row_acc, fn(col_acc, pj) {
          if pj.value == null then col_acc
          else
            let wi = cast.float(pi.value) in
            let wj = cast.float(pj.value) in
            let aligned = align_returns(pi.returns, pj.returns, 252) in
            let cov = if aligned.n < 2 then null else covariance_of(aligned.xs, aligned.ys) in
            if cov == null then col_acc
            else col_acc + wi * wj * cov
        })
    }) in
    let vol = if variance <= 0.0 then 0.0 else math.sqrt(variance) in
    vol * z_score
}

fn returns_from_prices(price_rows, symbol) {
  let rows = list.filter(price_rows, fn(r) { r.symbol == symbol })
  let sorted = list.sort_by(rows, fn(a, b) { if a.ts_unix < b.ts_unix then 0 - 1 else if a.ts_unix > b.ts_unix then 1 else 0 })
  let n = list.len(sorted)
  if n < 2 then []
  else
    let pairs = list.fold(sorted, { prev: null, returns: [] }, fn(acc, r) {
      if acc.prev == null then { prev: r.mid, returns: [] }
      else if acc.prev == 0 then { prev: r.mid, returns: acc.returns }
      else
        let ret = (cast.float(r.mid) - cast.float(acc.prev)) / cast.float(acc.prev) in
        { prev: r.mid, returns: list.append(acc.returns, ret) }
    }) in
    pairs.returns
}

fn stddev_of(values) {
  let n = list.len(values)
  if n < 2 then null
  else
    let sum = list.fold(values, 0, fn(acc, x) { acc + x }) in
    let mean = cast.float(sum) / cast.float(n) in
    let sq_sum = list.fold(values, 0, fn(acc, x) { let d = x - mean in acc + (d * d) }) in
    let variance = cast.float(sq_sum) / cast.float(n - 1) in
    if variance < 0 then null
    else variance
}

fn var_of(position_value, volatility, z_score) {
  if position_value == null then null
  else if volatility == null then null
  else
    let abs_val = if position_value < 0 then 0 - position_value else position_value in
    abs_val * volatility * z_score
}

fn position_var(p, price_rows, prices_mod) {
  if p.value == null then { var_95: null, var_99: null, volatility: null }
  else
    let sym = str.concat([p.instrument, "/USD"]) in
    let rets = returns_from_prices(price_rows, sym) in
    let vol = stddev_of(rets) in
    {
      var_95: var_of(p.value, vol, 1.645),
      var_99: var_of(p.value, vol, 2.326),
      volatility: vol
    }
}

fn percentile_of(sorted_values, pct) {
  let n = list.len(sorted_values)
  if n == 0 then null
  else
    let idx = (n * pct) / 100 in
    let i = if idx < 0 then 0 else if idx >= n then n - 1 else idx in
    sorted_values[i]
}

fn tail_mean_of(sorted_losses, cutoff_idx) {
  let tail = list.take(sorted_losses, cutoff_idx) in
  let n = list.len(tail) in
  if n == 0 then null
  else
    let sum = list.fold(tail, 0.0, fn(acc, x) { acc + x }) in
    sum / cast.float(n)
}

fn historical_var_of(position_value, price_rows, symbol) {
  if position_value == null then { hvar_95: null, hvar_99: null, es_95: null, es_99: null, n_returns: 0 }
  else
    let all_rets = returns_from_prices(price_rows, symbol) in
    let all_n = list.len(all_rets) in
    let rets = if all_n > 252 then list.drop(all_rets, all_n - 252) else all_rets in
    let n = list.len(rets) in
    if n < 10 then { hvar_95: null, hvar_99: null, es_95: null, es_99: null, n_returns: n }
    else
      let pnl = list.map(rets, fn(r) { cast.float(position_value) * r }) in
      let sorted = list.sort_by(pnl, fn(a, b) {
        if a < b then 0 - 1 else if a > b then 1 else 0
      }) in
      let idx_95 = (n * 5) / 100 in
      let idx_99 = (n * 1) / 100 in
      let loss_95 = percentile_of(sorted, 5) in
      let loss_99 = percentile_of(sorted, 1) in
      let hvar_95 = if loss_95 == null then null else if loss_95 < 0.0 then 0.0 - loss_95 else 0.0 in
      let hvar_99 = if loss_99 == null then null else if loss_99 < 0.0 then 0.0 - loss_99 else 0.0 in
      let tail_95 = tail_mean_of(sorted, if idx_95 < 1 then 1 else idx_95) in
      let tail_99 = tail_mean_of(sorted, if idx_99 < 1 then 1 else idx_99) in
      let es_95 = if tail_95 == null then null else if tail_95 < 0.0 then 0.0 - tail_95 else 0.0 in
      let es_99 = if tail_99 == null then null else if tail_99 < 0.0 then 0.0 - tail_99 else 0.0 in
      { hvar_95: hvar_95, hvar_99: hvar_99, es_95: es_95, es_99: es_99, n_returns: n }
}

fn position_historical_var(p, price_rows) {
  if p.value == null then { hvar_95: null, hvar_99: null, n_returns: 0 }
  else
    let sym = str.concat([p.instrument, "/USD"]) in
    historical_var_of(p.value, price_rows, sym)
}


fn risk_state_of(positions, cash_balance) {
  risk_state_with_var(positions, cash_balance, [])
}

fn risk_state_with_var(positions, cash_balance, price_rows) {
  let nav = nav_of(positions, cash_balance)
  let gross = gross_exposure_of(positions)
  let net = net_exposure_of(positions)
  let long_exposure = long_exposure_of(positions)
  let short_exposure = short_exposure_of(positions)
  let position_risk = list.map(positions, fn(p) {
    let weight = weight_of(p.value, gross)
    let abs_value = if p.value == null then null else if p.value < 0 then 0 - p.value else p.value
    let pvar = position_var(p, price_rows, null)
    let hvar = position_historical_var(p, price_rows)
    {
      instrument: p.instrument,
      qty: p.qty,
      price: p.price,
      value: p.value,
      abs_value: abs_value,
      weight: weight,
      var_95: pvar.var_95,
      var_99: pvar.var_99,
      volatility: pvar.volatility,
      hvar_95: hvar.hvar_95,
      hvar_99: hvar.hvar_99,
      es_95: hvar.es_95,
      es_99: hvar.es_99,
      n_returns: hvar.n_returns
    }
  })
  let concentration = max_abs_weight_of(position_risk)
  let portfolio_var_95 = list.fold(position_risk, 0, fn(acc, p) { if p.var_95 == null then acc else acc + p.var_95 })
  let portfolio_var_99 = list.fold(position_risk, 0, fn(acc, p) { if p.var_99 == null then acc else acc + p.var_99 })
  let portfolio_hvar_95 = list.fold(position_risk, 0, fn(acc, p) { if p.hvar_95 == null then acc else acc + p.hvar_95 })
  let portfolio_hvar_99 = list.fold(position_risk, 0, fn(acc, p) { if p.hvar_99 == null then acc else acc + p.hvar_99 })
  let portfolio_es_95 = list.fold(position_risk, 0, fn(acc, p) { if p.es_95 == null then acc else acc + p.es_95 })
  let portfolio_es_99 = list.fold(position_risk, 0, fn(acc, p) { if p.es_99 == null then acc else acc + p.es_99 })
  let covar_var_95 = portfolio_covar_var(positions, price_rows, 1.645)
  let covar_var_99 = portfolio_covar_var(positions, price_rows, 2.326)
  let mc_var = mc_portfolio_var(positions, price_rows, 1000, 42)
  let mc_chol = mc_cholesky_var(positions, price_rows, 1000, 42)
  let mc_t = mc_cholesky_t_var(positions, price_rows, 1000, 42, 4)
  {
    nav: nav,
    cash_balance: cash_balance,
    gross_exposure: gross,
    net_exposure: net,
    long_exposure: long_exposure,
    short_exposure: short_exposure,
    leverage: if nav == 0 then null else gross / cast.float(nav),
    concentration: concentration,
    portfolio_var_95: portfolio_var_95,
    portfolio_var_99: portfolio_var_99,
    portfolio_hvar_95: portfolio_hvar_95,
    portfolio_hvar_99: portfolio_hvar_99,
    portfolio_es_95: portfolio_es_95,
    portfolio_es_99: portfolio_es_99,
    portfolio_covar_var_95: covar_var_95,
    portfolio_covar_var_99: covar_var_99,
    portfolio_mc_var_95: mc_var.mc_var_95,
    portfolio_mc_var_99: mc_var.mc_var_99,
    mc_n_sims: mc_var.n_sims,
    mc_seed: mc_var.seed,
    portfolio_mc_chol_var_95: mc_chol.mc_var_95,
    portfolio_mc_chol_var_99: mc_chol.mc_var_99,
    portfolio_mc_t_var_95: mc_t.mc_var_95,
    portfolio_mc_t_var_99: mc_t.mc_var_99,
    mc_t_nu: mc_t.nu,
    positions: position_risk
  }
}

fn state_payload_from_objects(account, fill_rows, cash_rows, price_rows, positions, as_of_ts) {
  let fill_digests = list.map(fill_rows, fn(r) { r.digest })
  let cash_digests = list.map(cash_rows, fn(r) { r.digest })
  let price_digests = list.map(price_rows, fn(r) { r.digest })
  let cash_balance = cash_balance_of(cash_rows)
  let risk_state = risk_state_of(positions, cash_balance)
  {
    account: account,
    as_of_ts: as_of_ts,
    fill_digests: fill_digests,
    cash_digests: cash_digests,
    price_digests: price_digests,
    positions: positions,
    cash_balance: cash_balance,
    nav: nav_of(positions, cash_balance),
    risk_state: risk_state
  }
}

fn state_receipt_from_objects(account, fill_rows, cash_rows, price_rows, positions, as_of_ts) {
  let payload = state_payload_from_objects(account, fill_rows, cash_rows, price_rows, positions, as_of_ts)
  {
    state_digest: hash.sha256_text(json.encode(payload)),
    fill_count: list.len(payload.fill_digests),
    cash_count: list.len(payload.cash_digests),
    price_count: list.len(payload.price_digests),
    risk_state: payload.risk_state
  }
}

fn state_receipt_verified(account, fill_rows, cash_rows, price_rows, positions, as_of_ts, verification_summary) {
  let payload = state_payload_from_objects(account, fill_rows, cash_rows, price_rows, positions, as_of_ts) in
  let vs_digest = hash.sha256_text(json.encode(verification_summary)) in
  let verified_payload = { state: payload, verification_digest: vs_digest, all_valid: verification_summary.all_valid } in
  {
    state_digest: hash.sha256_text(json.encode(verified_payload)),
    verification_digest: vs_digest,
    verified: verification_summary.all_valid,
    fill_count: list.len(payload.fill_digests),
    cash_count: list.len(payload.cash_digests),
    price_count: list.len(payload.price_digests),
    risk_state: payload.risk_state
  }
}

fn fx_rates_from_prices(price_rows, prices_mod) {
  let fx_rows = list.filter(price_rows, fn(r) { str.ends_with(r.symbol, "/USD") })
  list.fold(fx_rows, {}, fn(acc, r) {
    let parts = str.split(r.symbol, "/")
    let base_currency = if list.len(parts) > 0 then parts[0] else ""
    if base_currency == "" || base_currency == "USD" then acc
    else
      let rate = prices_mod.consensus_price(price_rows, r.symbol) in
      if rate == null then acc
      else rec.set(acc, base_currency, rate)
  })
}

fn fx_rate_for(currency, fx_rates) {
  if currency == "USD" then 1
  else if rec.has(fx_rates, currency) then rec.get(fx_rates, currency)
  else null
}

fn cash_balance_usd_of(cash_rows, fx_rates) {
  list.fold(cash_rows, 0, fn(acc, r) {
    let currency = if rec.has(r, "currency") then r.currency else "USD" in
    let rate = fx_rate_for(currency, fx_rates) in
    if rate == null then acc
    else acc + (r.amount * rate)
  })
}

fn nav_usd_of(positions, cash_rows, fx_rates) {
  let cash_usd = cash_balance_usd_of(cash_rows, fx_rates) in
  let positions_usd = list.fold(positions, 0, fn(acc, p) {
    if p.value == null then acc
    else
      let currency = if rec.has(p, "currency") then p.currency else "USD" in
      let rate = fx_rate_for(currency, fx_rates) in
      if rate == null then acc
      else acc + (p.value * rate)
  }) in
  cash_usd + positions_usd
}


fn cost_basis_of(fill_rows, instrument) {
  let inst_fills = list.filter(fill_rows, fn(r) { r.instrument == instrument })
  let result = list.fold(inst_fills, { total_cost: 0, total_qty: 0 }, fn(acc, r) {
    if r.side == "buy" then
      { total_cost: acc.total_cost + (r.qty * r.price), total_qty: acc.total_qty + r.qty }
    else
      { total_cost: acc.total_cost, total_qty: acc.total_qty }
  })
  if result.total_qty == 0 then null
  else result.total_cost / result.total_qty
}

fn realized_pnl_of(fill_rows, instrument) {
  let inst_fills = list.sort_by(
    list.filter(fill_rows, fn(r) { r.instrument == instrument }),
    fn(a, b) { a.ts_unix - b.ts_unix }
  )
  let result = list.fold(inst_fills, { avg_cost: 0, qty: 0, realized: 0 }, fn(acc, r) {
    if r.side == "buy" then
      let new_qty = acc.qty + r.qty in
      let new_cost = if new_qty == 0 then 0
        else (acc.avg_cost * acc.qty + r.price * r.qty) / new_qty in
      { avg_cost: new_cost, qty: new_qty, realized: acc.realized }
    else
      let sell_qty = if r.qty > acc.qty then acc.qty else r.qty in
      let pnl = sell_qty * (r.price - acc.avg_cost) in
      { avg_cost: acc.avg_cost, qty: acc.qty - sell_qty, realized: acc.realized + pnl }
  })
  result.realized
}



fn is_rule_active(rule, as_of_ts) {
  let eff = if rec.has(rule, "effective_ts") then rule.effective_ts else 0 in
  let exp = if rec.has(rule, "expiry_ts") then rule.expiry_ts else 0 in
  let after_effective = as_of_ts == null || eff == 0 || as_of_ts >= eff in
  let before_expiry = exp == 0 || as_of_ts == null || as_of_ts < exp in
  after_effective && before_expiry
}

fn breach_result(rule_type, severity, breach, suggested) {
  { passed: false, rule_type: rule_type, severity: severity, breach: breach, suggested_action: suggested }
}

fn pass_result(rule_type) {
  { passed: true, rule_type: rule_type, severity: null, breach: null, suggested_action: null }
}

fn check_rule(rule, positions, risk_state, as_of_ts) {
  let rule_type = if rec.has(rule, "rule_type") then rule.rule_type else "" in
  let params = if rec.has(rule, "params") then rule.params else {} in
  let severity = if rec.has(rule, "severity") then rule.severity else "hard" in
  if !is_rule_active(rule, as_of_ts) then pass_result(rule_type)
  else if rule_type == "max_position_size" then
    let instrument = if rec.has(params, "instrument") then params.instrument else "" in
    let max_value = if rec.has(params, "max_value") then params.max_value else 0 in
    let hit = list.find(positions, fn(p) { p.instrument == instrument }) in
    let pos = if rec.has(hit, "some") then hit.some else null in
    let value = if pos == null then 0 else if pos.value == null then 0 else pos.value in
    let abs_value = if value < 0 then 0 - value else value in
    if abs_value > max_value then
      breach_result(rule_type, severity,
        str.concat(["position ", instrument, " value ", str.from(abs_value), " exceeds max ", str.from(max_value)]),
        str.concat(["reduce ", instrument, " by ", str.from(abs_value - max_value)]))
    else pass_result(rule_type)
  else if rule_type == "max_concentration" then
    let max_pct = if rec.has(params, "max_pct") then params.max_pct else 100 in
    let concentration = if rec.has(risk_state, "concentration") then risk_state.concentration else 0 in
    let pct = if concentration == null then 0 else concentration * 100 in
    if pct > max_pct then
      breach_result(rule_type, severity,
        str.concat(["concentration ", str.from(pct), "% exceeds max ", str.from(max_pct), "%"]),
        str.concat(["diversify portfolio to reduce max position weight below ", str.from(max_pct), "%"]))
    else pass_result(rule_type)
  else if rule_type == "max_leverage" then
    let max_lev = if rec.has(params, "max_leverage") then params.max_leverage else 0 in
    let leverage = if rec.has(risk_state, "leverage") then risk_state.leverage else 0 in
    let lev = if leverage == null then 0 else leverage in
    if lev > max_lev then
      breach_result(rule_type, severity,
        str.concat(["leverage ", str.from(lev), " exceeds max ", str.from(max_lev)]),
        str.concat(["reduce gross exposure or increase cash to bring leverage below ", str.from(max_lev)]))
    else pass_result(rule_type)
  else if rule_type == "max_gross_exposure" then
    let max_exp = if rec.has(params, "max_value") then params.max_value else 0 in
    let gross = if rec.has(risk_state, "gross_exposure") then risk_state.gross_exposure else 0 in
    if gross > max_exp then
      breach_result(rule_type, severity,
        str.concat(["gross exposure ", str.from(gross), " exceeds max ", str.from(max_exp)]),
        str.concat(["reduce positions by ", str.from(gross - max_exp)]))
    else pass_result(rule_type)
  else if rule_type == "max_portfolio_var_95" then
    let max_var = if rec.has(params, "max_value") then params.max_value else 0 in
    let pvar = if rec.has(risk_state, "portfolio_var_95") then risk_state.portfolio_var_95 else 0 in
    let v = if pvar == null then 0 else pvar in
    if v > max_var then
      breach_result(rule_type, severity,
        str.concat(["portfolio VaR 95% ", str.from(v), " exceeds max ", str.from(max_var)]),
        "reduce position sizes or move to lower-volatility instruments")
    else pass_result(rule_type)
  else if rule_type == "max_portfolio_var_99" then
    let max_var = if rec.has(params, "max_value") then params.max_value else 0 in
    let pvar = if rec.has(risk_state, "portfolio_var_99") then risk_state.portfolio_var_99 else 0 in
    let v = if pvar == null then 0 else pvar in
    if v > max_var then
      breach_result(rule_type, severity,
        str.concat(["portfolio VaR 99% ", str.from(v), " exceeds max ", str.from(max_var)]),
        "reduce position sizes or move to lower-volatility instruments")
    else pass_result(rule_type)
  else if rule_type == "min_cash_pct" then
    let min_pct = if rec.has(params, "min_pct") then params.min_pct else 0 in
    let nav = if rec.has(risk_state, "nav") then risk_state.nav else 0 in
    let cash = if rec.has(risk_state, "cash_balance") then risk_state.cash_balance else 0 in
    let pct = if nav == 0 then 0 else (cash * 100) / nav in
    if pct < min_pct then
      breach_result(rule_type, severity,
        str.concat(["cash ", str.from(pct), "% below minimum ", str.from(min_pct), "%"]),
        str.concat(["increase cash allocation to at least ", str.from(min_pct), "% of NAV"]))
    else pass_result(rule_type)
  else if rule_type == "max_position_qty" then
    let instrument = if rec.has(params, "instrument") then params.instrument else "" in
    let max_qty = if rec.has(params, "max_qty") then params.max_qty else 0 in
    let hit = list.find(positions, fn(p) { p.instrument == instrument }) in
    let pos = if rec.has(hit, "some") then hit.some else null in
    let qty = if pos == null then 0 else pos.qty in
    let abs_qty = if qty < 0 then 0 - qty else qty in
    if abs_qty > max_qty then
      breach_result(rule_type, severity,
        str.concat(["position ", instrument, " qty ", str.from(abs_qty), " exceeds max ", str.from(max_qty)]),
        str.concat(["reduce ", instrument, " qty by ", str.from(abs_qty - max_qty)]))
    else pass_result(rule_type)
  else if rule_type == "max_asset_class_exposure" then
    let asset_class = if rec.has(params, "asset_class") then params.asset_class else "" in
    let max_value = if rec.has(params, "max_value") then params.max_value else 0 in
    let class_positions = list.filter(positions, fn(p) {
      let ac = if rec.has(p, "asset_class") then p.asset_class else "equity" in
      ac == asset_class
    }) in
    let exposure = list.fold(class_positions, 0, fn(acc, p) {
      if p.value == null then acc
      else if p.value < 0 then acc + (0 - p.value)
      else acc + p.value
    }) in
    if exposure > max_value then
      breach_result(rule_type, severity,
        str.concat([asset_class, " exposure ", str.from(exposure), " exceeds max ", str.from(max_value)]),
        str.concat(["reduce ", asset_class, " positions by ", str.from(exposure - max_value)]))
    else pass_result(rule_type)
  else if rule_type == "instrument_blacklist" then
    let blacklist = if rec.has(params, "instruments") then params.instruments else [] in
    let breaching = list.filter(positions, fn(p) {
      rec.has(list.find(blacklist, fn(b) { b == p.instrument }), "some")
    }) in
    if list.len(breaching) > 0 then
      breach_result(rule_type, severity,
        str.concat(["blacklisted instruments held:", list.fold(breaching, "", fn(acc, p) { str.concat([acc, " ", p.instrument]) })]),
        str.concat(["exit positions in:", list.fold(breaching, "", fn(acc, p) { str.concat([acc, " ", p.instrument]) })]))
    else pass_result(rule_type)
  else if rule_type == "max_delta_exposure" then
    let max_exp = if rec.has(params, "max_value") then params.max_value else 0 in
    let gross = if rec.has(risk_state, "gross_exposure") then risk_state.gross_exposure else 0.0 in
    let g = if gross == null then 0.0 else gross in
    if g > cast.float(max_exp) then
      breach_result(rule_type, severity,
        str.concat(["delta-adjusted gross exposure ", str.from(g), " exceeds max ", str.from(max_exp)]),
        str.concat(["reduce delta-adjusted exposure by ", str.from(g - cast.float(max_exp))]))
    else pass_result(rule_type)
  else if rule_type == "max_vega" then
    let max_vega = if rec.has(params, "max_value") then params.max_value else 0 in
    let positions = if rec.has(risk_state, "positions") then risk_state.positions else [] in
    let total_vega = list.fold(positions, 0.0, fn(acc, p) {
      let greeks = if rec.has(p, "greeks") then p.greeks else null in
      if greeks == null then acc
      else
        let v = if rec.has(greeks, "vega") then greeks.vega else null in
        if v == null then acc
        else if v < 0.0 then acc + (0.0 - v)
        else acc + v
    }) in
    if total_vega > cast.float(max_vega) then
      breach_result(rule_type, severity,
        str.concat(["portfolio vega ", str.from(total_vega), " exceeds max ", str.from(max_vega)]),
        "reduce options positions or hedge vega exposure")
    else pass_result(rule_type)
  else if rule_type == "max_portfolio_covar_var_95" then
    let max_var = if rec.has(params, "max_value") then params.max_value else 0 in
    let cvar = if rec.has(risk_state, "portfolio_covar_var_95") then risk_state.portfolio_covar_var_95 else 0.0 in
    let v = if cvar == null then 0.0 else cvar in
    if v > cast.float(max_var) then
      breach_result(rule_type, severity,
        str.concat(["portfolio covar VaR 95% ", str.from(v), " exceeds max ", str.from(max_var)]),
        "reduce correlated positions or increase diversification")
    else pass_result(rule_type)
  else if rule_type == "max_portfolio_covar_var_99" then
    let max_var = if rec.has(params, "max_value") then params.max_value else 0 in
    let cvar = if rec.has(risk_state, "portfolio_covar_var_99") then risk_state.portfolio_covar_var_99 else 0.0 in
    let v = if cvar == null then 0.0 else cvar in
    if v > cast.float(max_var) then
      breach_result(rule_type, severity,
        str.concat(["portfolio covar VaR 99% ", str.from(v), " exceeds max ", str.from(max_var)]),
        "reduce correlated positions or increase diversification")
    else pass_result(rule_type)
  else if rule_type == "max_es_95" then
    let max_es = if rec.has(params, "max_value") then params.max_value else 0 in
    let es = if rec.has(risk_state, "portfolio_es_95") then risk_state.portfolio_es_95 else 0.0 in
    let v = if es == null then 0.0 else es in
    if v > cast.float(max_es) then
      breach_result(rule_type, severity,
        str.concat(["portfolio ES 95% ", str.from(v), " exceeds max ", str.from(max_es)]),
        "reduce tail risk exposure")
    else pass_result(rule_type)
  else if rule_type == "max_es_99" then
    let max_es = if rec.has(params, "max_value") then params.max_value else 0 in
    let es = if rec.has(risk_state, "portfolio_es_99") then risk_state.portfolio_es_99 else 0.0 in
    let v = if es == null then 0.0 else es in
    if v > cast.float(max_es) then
      breach_result(rule_type, severity,
        str.concat(["portfolio ES 99% ", str.from(v), " exceeds max ", str.from(max_es)]),
        "reduce tail risk exposure")
    else pass_result(rule_type)
  else if rule_type == "max_illiquid_pct" then
    let max_pct = if rec.has(params, "max_pct") then params.max_pct else 100 in
    let private_nav = if rec.has(risk_state, "private_nav") then risk_state.private_nav else 0.0 in
    let pn = if private_nav == null then 0.0 else private_nav in
    let pub_nav = if rec.has(risk_state, "nav") then cast.float(risk_state.nav) else 0.0 in
    let total_nav = pub_nav + pn in
    let illiquid_pct = if total_nav == 0.0 then 0.0 else (pn / total_nav) * 100.0 in
    if illiquid_pct > cast.float(max_pct) then
      breach_result(rule_type, severity,
        str.concat(["illiquid allocation ", str.from(illiquid_pct), "% exceeds max ", str.from(max_pct), "%"]),
        str.concat(["reduce private market exposure to below ", str.from(max_pct), "% of total NAV"]))
    else pass_result(rule_type)
  else if rule_type == "max_capital_call_exposure" then
    let max_value = if rec.has(params, "max_value") then params.max_value else 0 in
    let pv_calls = if rec.has(risk_state, "pv_capital_calls") then risk_state.pv_capital_calls else 0.0 in
    let v = if pv_calls == null then 0.0 else pv_calls in
    if v > cast.float(max_value) then
      breach_result(rule_type, severity,
        str.concat(["PV capital call exposure ", str.from(v), " exceeds max ", str.from(max_value)]),
        str.concat(["reduce unfunded commitments to below ", str.from(max_value)]))
    else pass_result(rule_type)
  else
    pass_result(rule_type)
}

fn severity_rank(s) {
  if s == "hard" then 3
  else if s == "warn" then 2
  else if s == "info" then 1
  else 0
}

fn dedup_by_rule_id(results) {
  list.fold(results, [], fn(acc, r) {
    let existing = list.find(acc, fn(x) { x.rule_id == r.rule_id }) in
    if !rec.has(existing, "some") then list.append(acc, r)
    else
      let ex = existing.some in
      let ex_rank = if ex.passed then 0 else severity_rank(ex.severity) in
      let r_rank = if r.passed then 0 else severity_rank(r.severity) in
      if r_rank > ex_rank then
        list.map(acc, fn(x) { if x.rule_id == r.rule_id then r else x })
      else acc
  })
}

fn evaluate_compliance(rules, positions, risk_state, as_of_ts) {
  let raw_results = list.map(rules, fn(rule) {
    let r = check_rule(rule, positions, risk_state, as_of_ts) in
    { rule_id: (if rec.has(rule, "rule_id") then rule.rule_id else ""), passed: r.passed, rule_type: r.rule_type, severity: r.severity, breach: r.breach, suggested_action: r.suggested_action }
  }) in
  let results = dedup_by_rule_id(raw_results) in
  let hard_breaches = list.filter(results, fn(r) { !r.passed && r.severity == "hard" }) in
  let warnings = list.filter(results, fn(r) { !r.passed && r.severity == "warn" }) in
  let info = list.filter(results, fn(r) { !r.passed && r.severity == "info" }) in
  let all_breaches = list.filter(results, fn(r) { !r.passed }) in
  { passed: list.len(hard_breaches) == 0, results: results, breach_count: list.len(all_breaches), hard_breach_count: list.len(hard_breaches), warning_count: list.len(warnings), breaches: all_breaches, hard_breaches: hard_breaches, warnings: warnings, info: info }
}

fn attribution_of(fill_rows, positions, beginning_nav) {
  let items = list.map(positions, fn(p) {
    let avg_cost = cost_basis_of(fill_rows, p.instrument) in
    let unrealized_pnl = if avg_cost == null || p.price == null then null
      else (p.price - avg_cost) * p.qty in
    let realized_pnl = realized_pnl_of(fill_rows, p.instrument) in
    let total_pnl = if unrealized_pnl == null then realized_pnl
      else if realized_pnl == null then unrealized_pnl
      else unrealized_pnl + realized_pnl in
    let contribution = if total_pnl == null || beginning_nav == null || beginning_nav == 0 then null
      else cast.float(total_pnl) / cast.float(beginning_nav) in
    {
      instrument: p.instrument,
      qty: p.qty,
      avg_cost: avg_cost,
      current_price: p.price,
      unrealized_pnl: unrealized_pnl,
      realized_pnl: realized_pnl,
      total_pnl: total_pnl,
      contribution: contribution
    }
  })
  let total_pnl = list.fold(items, 0, fn(acc, x) {
    if x.total_pnl == null then acc else acc + x.total_pnl
  })
  let portfolio_return = if beginning_nav == null || beginning_nav == 0 then null
    else cast.float(total_pnl) / cast.float(beginning_nav)
  {
    positions: items,
    total_pnl: total_pnl,
    portfolio_return: portfolio_return,
    beginning_nav: beginning_nav
  }
}

fn apply_corporate_actions(qty, instrument, ca_rows, as_of_ts) {
  let applicable = list.filter(ca_rows, fn(ca) {
    ca.instrument == instrument &&
    (as_of_ts == null || ca.effective_ts_unix <= as_of_ts)
  })
  let sorted = list.sort_by(applicable, fn(a, b) { if a.effective_ts_unix < b.effective_ts_unix then 0 - 1 else if a.effective_ts_unix > b.effective_ts_unix then 1 else 0 })
  list.fold(sorted, qty, fn(acc, ca) {
    let action_type = if rec.has(ca, "action_type") then ca.action_type else "" in
    let ratio_num = if rec.has(ca, "ratio_num") then ca.ratio_num else 1 in
    let ratio_den = if rec.has(ca, "ratio_den") then ca.ratio_den else 1 in
    if action_type == "split" then
      if ratio_den == 0 then acc else (acc * ratio_num) / ratio_den
    else if action_type == "reverse_split" then
      if ratio_num == 0 then acc else (acc * ratio_den) / ratio_num
    else acc
  })
}

fn qty_at_ex_date(fill_rows, instrument, ex_ts_unix) {
  let pre_ex_fills = list.filter(fill_rows, fn(r) {
    r.instrument == instrument && r.ts_unix < ex_ts_unix
  })
  list.fold(pre_ex_fills, 0, fn(acc, r) {
    let delta = if r.side == "buy" then r.qty else 0 - r.qty
    acc + delta
  })
}

fn dividend_cash_of(fill_rows, ca_rows, as_of_ts) {
  let dividends = list.filter(ca_rows, fn(ca) {
    let action_type = if rec.has(ca, "action_type") then ca.action_type else "" in
    let cash_amount = if rec.has(ca, "cash_amount") then ca.cash_amount else 0 in
    action_type == "dividend" &&
    cash_amount > 0 &&
    (as_of_ts == null || ca.effective_ts_unix <= as_of_ts)
  })
  list.fold(dividends, {}, fn(acc, ca) {
    let instrument = if rec.has(ca, "instrument") then ca.instrument else "" in
    let ex_ts = if rec.has(ca, "ex_ts_unix") then ca.ex_ts_unix else 0 in
    let cash_amount = if rec.has(ca, "cash_amount") then ca.cash_amount else 0 in
    let currency = if rec.has(ca, "currency") then ca.currency else "USD" in
    let qty = qty_at_ex_date(fill_rows, instrument, ex_ts) in
    let total = qty * cash_amount in
    if total == 0 then acc
    else if rec.has(acc, currency) then rec.set(acc, currency, rec.get(acc, currency) + total)
    else rec.set(acc, currency, total)
  })
}


fn positions_from_fills_with_actions(fill_rows, price_rows, prices_mod, inst_rows, ca_rows, as_of_ts) {
  let qtys = list.fold(fill_rows, {}, fn(acc, r) {
    let delta = if r.side == "buy" then r.qty else 0 - r.qty
    if rec.has(acc, r.instrument) then rec.set(acc, r.instrument, rec.get(acc, r.instrument) + delta)
    else rec.set(acc, r.instrument, delta)
  })
  let instruments = rec.keys(qtys)
  list.map(instruments, fn(inst) {
    let raw_qty = rec.get(qtys, inst) in
    let qty = apply_corporate_actions(raw_qty, inst, ca_rows, as_of_ts) in
    let hit = list.find(inst_rows, fn(r) { r.instrument_id == inst }) in
    let meta = if rec.has(hit, "some") then hit.some else null in
    let sym = price_symbol_for(inst, meta) in
    let price = prices_mod.consensus_price(price_rows, sym) in
    let value = value_position(qty, price, meta) in
    let asset_class = if meta == null then "equity" else if rec.has(meta, "asset_class") then meta.asset_class else "equity" in
    let greeks = if asset_class == "option" then position_greeks({ qty: qty }, meta, price, as_of_ts) else null in
    let ir_risk = if asset_class == "fixed_income" then bond_ir_risk(meta, qty, price, if as_of_ts == null then 0 else as_of_ts) else null in
    let inst_fills_a = list.filter(fill_rows, fn(f) { f.instrument == inst }) in
    let entry_price = if asset_class == "future" then
      let buy_fills = list.filter(inst_fills_a, fn(f) { f.side == "buy" }) in
      let total_cost = list.fold(buy_fills, 0.0, fn(acc, f) { acc + cast.float(f.qty) * cast.float(f.price) }) in
      let total_qty = list.fold(buy_fills, 0.0, fn(acc, f) { acc + cast.float(f.qty) }) in
      if total_qty == 0.0 then price else total_cost / total_qty
    else null in
    let notional = if asset_class == "future" then notional_position(qty, price, meta) else null in
    let mtm_pnl = if asset_class == "future" then mtm_pnl_of(qty, price, entry_price, meta) else null in
    let var_margin = if asset_class == "future" then variation_margin_of(if mtm_pnl == null then 0.0 else mtm_pnl) else null in
    let init_margin = if asset_class == "future" then initial_margin_of(qty, price, meta) else null in
    let expiry_ts = if meta != null && rec.has(meta, "expiry_ts_unix") then meta.expiry_ts_unix else null in
    { instrument: inst, qty: qty, price: price, value: value, asset_class: asset_class, greeks: greeks, ir_risk: ir_risk, notional: notional, entry_price: entry_price, mtm_pnl: mtm_pnl, variation_margin: var_margin, initial_margin: init_margin, expiry_ts: expiry_ts }
  })
}

