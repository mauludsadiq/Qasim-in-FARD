  if payload_json == "" then err_json_h(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json_h(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json_h(400, "missing sig_b64")
  else if !verify_payload_h(ctx, issuer_pk_hex, sig_b64, payload_json) then err_json_h(401, "bad sig")
  else
    let p = json.decode(payload_json) in
    let instrument = if rec.has(p, "instrument") then rec.get(p, "instrument") else "" in
    let effective_ts_unix = if rec.has(p, "effective_ts_unix") then rec.get(p, "effective_ts_unix") else 0 in
    if instrument == "" then err_json_h(400, "missing instrument")
    else
      let obj = ctx.qasim_objects.corporate_action(
        (if rec.has(p, "action_id") then rec.get(p, "action_id") else ""),
        instrument,
        (if rec.has(p, "action_type") then rec.get(p, "action_type") else ""),
        (if rec.has(p, "ex_ts_unix") then rec.get(p, "ex_ts_unix") else 0),
        effective_ts_unix,
        (if rec.has(p, "ratio_num") then rec.get(p, "ratio_num") else 1),
        (if rec.has(p, "ratio_den") then rec.get(p, "ratio_den") else 1),
        (if rec.has(p, "cash_amount") then rec.get(p, "cash_amount") else 0),
        (if rec.has(p, "currency") then rec.get(p, "currency") else "USD"),
        issuer_pk_hex, sig_b64
      ) in
      let _ = sqlite.exec(db, str.concat([
        "INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
        obj.digest, "','corporate_action',NULL,'",
        instrument, "',",
        str.from(effective_ts_unix), ",'",
        issuer_pk_hex, "','", sig_b64, "','", payload_json, "')"
      ])) in
      ok_json_h({ object_type: obj.object_type, digest: obj.digest, instrument: instrument })
}

