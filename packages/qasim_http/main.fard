}

fn replay(req, state_mod, ok_json) {
  let body = json.decode(req.body)
  let account = if rec.has(body, "account") then rec.get(body, "account") else ""
  let tx_rows = if rec.has(body, "txs") then rec.get(body, "txs") else []
  let price_rows = if rec.has(body, "prices") then rec.get(body, "prices") else []
  let as_of_ts = if rec.has(body, "as_of_ts") then rec.get(body, "as_of_ts") else null
  let tx_rows2 = if as_of_ts == null then tx_rows else list.filter(tx_rows, fn(r) { r.ts_unix <= as_of_ts })
  let price_rows2 = if as_of_ts == null then price_rows else list.filter(price_rows, fn(r) { r.ts_unix <= as_of_ts })
  let inst_rows = instrument_rows(db)
  let positions = state_mod.positions_from_fills_with_meta(tx_rows2, price_rows2, qasim_prices, inst_rows)
  let payload = {
    account: account,
    as_of_ts: as_of_ts,
    fill_digests: list.map(tx_rows2, fn(r) { if rec.has(r, "digest") then r.digest else hash.sha256_text(json.canonicalize(r)) }),
    price_digests: list.map(price_rows2, fn(r) { if rec.has(r, "digest") then r.digest else hash.sha256_text(json.canonicalize(r)) }),
    positions: positions,
    nav: state_mod.nav_of(positions, state_mod.cash_balance_of(cash))
  }
  ok_json({ account: account, as_of_ts: as_of_ts, positions: positions, nav: state_mod.nav_of(positions, state_mod.cash_balance_of(cash)), risk_state: state_mod.risk_state_of(positions, state_mod.cash_balance_of(cash)), state_digest: hash.sha256_text(json.encode(payload)), tx_count: list.len(tx_rows2), price_count: list.len(price_rows2) })
}


fn parse_shock_map(shock_text) {
  let pairs = if shock_text == "" || shock_text == "{}" then [] else str.split(shock_text, ",")
  list.fold(pairs, { "_default": 0 }, fn(acc, item) {
    let kv = str.split(item, ":")
    if list.len(kv) < 2 then acc
    else rec.set(acc, kv[0], json.decode(kv[1]))
  })
}

fn state_payload_at(req, db, prices_mod, state_mod, max_price_age, ok_json, err_json) {
  let prefix = "/finance/state_payload/"
  let rest = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path)))
  let parts = str.split(rest, "/")
  let account = if list.len(parts) > 0 then parts[0] else ""
  let ts_unix_cutoff = if list.len(parts) > 1 then parts[1] else ""
  if account == "" then err_json(400, "missing account")
  else if ts_unix_cutoff == "" then err_json(400, "missing ts_unix")
  else
    let cutoff = json.decode(str.concat([ts_unix_cutoff])) in
    let fills = fill_rows_for_account_at(db, account, cutoff) in
    let cash = cash_rows_for_account_at(db, account, cutoff) in
    let prices = prices_mod.price_rows_at(db, cutoff, max_price_age) in
    let inst_rows = instrument_rows(db) in
  let positions = state_mod.positions_from_fills_with_meta(fills, prices, prices_mod, inst_rows) in
    ok_json(state_mod.state_payload_from_objects(account, fills, cash, prices, positions, cutoff))
}

fn scenario_at(req, db, prices_mod, state_mod, scenario_mod, max_price_age, ok_json, err_json) {
  let prefix = "/finance/scenario_at/"
  let rest = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path)))
  let parts = str.split(rest, "/")
  let account = if list.len(parts) > 0 then parts[0] else ""
  let ts_unix_cutoff = if list.len(parts) > 1 then parts[1] else ""
  let shock_text = if list.len(parts) > 2 then parts[2] else ""
  if account == "" then err_json(400, "missing account")
  else if ts_unix_cutoff == "" then err_json(400, "missing ts_unix")
  else
    let cutoff = json.decode(str.concat([ts_unix_cutoff])) in
    let shock = if str.contains(shock_text, ":") then parse_shock_map(shock_text) else { scenario_name: shock_text } in
    let fills = fill_rows_for_account_at(db, account, cutoff) in
    let cash = cash_rows_for_account_at(db, account, cutoff) in
    let prices = prices_mod.price_rows_at(db, cutoff, max_price_age) in
    let inst_rows = instrument_rows(db) in
  let positions = state_mod.positions_from_fills_with_meta(fills, prices, prices_mod, inst_rows) in
    let cash_balance = state_mod.cash_balance_of(cash) in
    let base_receipt = state_mod.state_receipt_from_objects(account, fills, cash, prices, positions, cutoff) in
    let raw_scenario = scenario_mod.scenario_state_of(account, cutoff, positions, shock, "ad_hoc") in
    let shocked_nav = cash_balance + raw_scenario.shocked_nav in
    let scenario_payload = {
      account: account,
      as_of_ts: cutoff,
      scenario: raw_scenario.scenario,
      scenario_version: raw_scenario.scenario_version,
      shock_spec: raw_scenario.shock_spec,
      shocked_positions: raw_scenario.shocked_positions,
      shocked_nav: shocked_nav,
      pnl: raw_scenario.pnl
    } in
    let scenario = {
      scenario: raw_scenario.scenario,
      scenario_version: raw_scenario.scenario_version,
      shock_spec: raw_scenario.shock_spec,
      shocked_positions: raw_scenario.shocked_positions,
      shocked_nav: shocked_nav,
      pnl: raw_scenario.pnl,
      scenario_digest: hash.sha256_text(json.encode(scenario_payload))
    } in
    ok_json({ account: account, as_of_ts: cutoff, positions: positions, cash_balance: cash_balance, nav: state_mod.nav_of(positions, cash_balance), risk_state: base_receipt.risk_state, state_digest: base_receipt.state_digest, scenario: scenario, fill_count: base_receipt.fill_count, cash_count: base_receipt.cash_count, price_count: base_receipt.price_count })
}


fn ok_json_h(v) {
  { status: 200, headers: { "Content-Type": "application/json" }, body: json.encode(v) }
}

fn err_json_h(status, msg) {
  { status: status, headers: { "Content-Type": "application/json" }, body: json.encode({ ok: false, error: msg }) }
}

fn hex_digest_h(payload_json) {
  hash.sha256_text(payload_json)
}

fn verify_payload_h(ctx, pk_hex, sig_b64, payload_json) {
  if pk_hex == "DEV" then true
  else
    let msg_hex = ctx.bytes.to_hex(ctx.bytes.of_str(payload_json)) in
    let sig_hex = ctx.bytes.to_hex(ctx.b64.decode(sig_b64)) in
    ctx.crypto.ed25519_verify(pk_hex, msg_hex, sig_hex)
}

fn health_h() {
  ok_json_h({ status: "ok" })
}

fn post_tx_h(req, ctx) {
  let db = ctx.db in
  let tx = json.decode(req.body) in
  let payload_json = if rec.has(tx, "payload_json") then rec.get(tx, "payload_json") else "" in
  let issuer_pk_hex = if rec.has(tx, "issuer_pk_hex") then rec.get(tx, "issuer_pk_hex") else "" in
  let sig_b64 = if rec.has(tx, "sig_b64") then rec.get(tx, "sig_b64") else "" in
  if payload_json == "" then err_json_h(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json_h(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json_h(400, "missing sig_b64")
  else if !verify_payload_h(ctx, issuer_pk_hex, sig_b64, payload_json) then err_json_h(401, "bad sig")
  else if (let now_rows = sqlite.query(db, "SELECT CAST(strftime('%s','now') AS INTEGER) AS ts") in now_rows[0].ts) < (if rec.has(tx, "ts_unix") then rec.get(tx, "ts_unix") else 0) then err_json_h(400, "ts_unix is in the future")
  else
    let d = hex_digest_h(payload_json) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR IGNORE INTO tx (digest,id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      d, "','",
      (if rec.has(tx, "id") then rec.get(tx, "id") else ""), "','",
      (if rec.has(tx, "account") then rec.get(tx, "account") else ""), "','",
      (if rec.has(tx, "instrument") then rec.get(tx, "instrument") else ""), "','",
      (if rec.has(tx, "side") then rec.get(tx, "side") else ""), "',",
      str.from(if rec.has(tx, "qty") then rec.get(tx, "qty") else 0), ",",
      str.from(if rec.has(tx, "price") then rec.get(tx, "price") else 0), ",",
      str.from(if rec.has(tx, "ts_unix") then rec.get(tx, "ts_unix") else 0), ",'",
      issuer_pk_hex, "','", sig_b64, "','", payload_json, "')"
    ])) in
    ok_json_h({ digest: d })
}

fn post_instrument_h(req, ctx) {
  let db = ctx.db in
  let body = json.decode(req.body) in
  let payload_json = if rec.has(body, "payload_json") then rec.get(body, "payload_json") else "" in
  let issuer_pk_hex = if rec.has(body, "issuer_pk_hex") then rec.get(body, "issuer_pk_hex") else "" in
  let sig_b64 = if rec.has(body, "sig_b64") then rec.get(body, "sig_b64") else "" in
  if payload_json == "" then err_json_h(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json_h(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json_h(400, "missing sig_b64")
  else if !verify_payload_h(ctx, issuer_pk_hex, sig_b64, payload_json) then err_json_h(401, "bad sig")
  else
    let obj = ctx.qasim_objects.instrument(
      (if rec.has(body, "instrument_id") then rec.get(body, "instrument_id") else ""),
      (if rec.has(body, "asset_class") then rec.get(body, "asset_class") else "equity"),
      (if rec.has(body, "symbol") then rec.get(body, "symbol") else ""),
      (if rec.has(body, "currency") then rec.get(body, "currency") else "USD"),
      (if rec.has(body, "venue") then rec.get(body, "venue") else ""),
      (if rec.has(body, "multiplier") then rec.get(body, "multiplier") else 1),
      (if rec.has(body, "expiry_ts_unix") then rec.get(body, "expiry_ts_unix") else 0),
      issuer_pk_hex, sig_b64
    ) in
    let instrument_id = obj.payload.instrument_id in
    if instrument_id == "" then err_json_h(400, "missing instrument_id")
    else
      let _ = sqlite.exec(db, str.concat([
        "INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES (",
        "'", obj.digest, "','instrument',NULL,'",
        instrument_id, "',0,'",
        issuer_pk_hex, "','",
        sig_b64, "','",
        payload_json, "')"
      ])) in
      ok_json_h({ object_type: obj.object_type, digest: obj.digest, instrument_id: instrument_id })
}

fn post_cash_h(req, ctx) {
  let db = ctx.db in
  let body = json.decode(req.body) in
  let payload_json = if rec.has(body, "payload_json") then rec.get(body, "payload_json") else "" in
  let issuer_pk_hex = if rec.has(body, "issuer_pk_hex") then rec.get(body, "issuer_pk_hex") else "" in
  let sig_b64 = if rec.has(body, "sig_b64") then rec.get(body, "sig_b64") else "" in
  if payload_json == "" then err_json_h(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json_h(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json_h(400, "missing sig_b64")
  else if !verify_payload_h(ctx, issuer_pk_hex, sig_b64, payload_json) then err_json_h(401, "bad sig")
  else if (let now_rows = sqlite.query(db, "SELECT CAST(strftime('%s','now') AS INTEGER) AS ts") in now_rows[0].ts) < (if rec.has(body, "ts_unix") then rec.get(body, "ts_unix") else 0) then err_json_h(400, "ts_unix is in the future")
  else
    let obj = ctx.qasim_objects.cash(
      (if rec.has(body, "account") then rec.get(body, "account") else ""),
      (if rec.has(body, "currency") then rec.get(body, "currency") else ""),
      (if rec.has(body, "amount") then rec.get(body, "amount") else 0),
      (if rec.has(body, "ts_unix") then rec.get(body, "ts_unix") else 0),
      issuer_pk_hex, sig_b64
    ) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR IGNORE INTO cash_objects (digest,account,currency,amount,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      obj.digest, "','", obj.payload.account, "','", obj.payload.currency, "',",
      str.from(obj.payload.amount), ",", str.from(obj.payload.ts_unix), ",'",
      issuer_pk_hex, "','", sig_b64, "','", payload_json, "')"
    ])) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      obj.digest, "','", obj.object_type, "','", obj.payload.account, "',NULL,",
      str.from(obj.payload.ts_unix), ",'", issuer_pk_hex, "','", sig_b64, "','", payload_json, "')"
    ])) in
    ok_json_h({ object_type: obj.object_type, digest: obj.digest })
}

fn post_order_h(req, ctx) {
  let db = ctx.db in
  let body = json.decode(req.body) in
  let payload_json = if rec.has(body, "payload_json") then rec.get(body, "payload_json") else "" in
  let issuer_pk_hex = if rec.has(body, "issuer_pk_hex") then rec.get(body, "issuer_pk_hex") else "" in
  let sig_b64 = if rec.has(body, "sig_b64") then rec.get(body, "sig_b64") else "" in
  if payload_json == "" then err_json_h(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json_h(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json_h(400, "missing sig_b64")
  else if !verify_payload_h(ctx, issuer_pk_hex, sig_b64, payload_json) then err_json_h(401, "bad sig")
  else if (let now_rows = sqlite.query(db, "SELECT CAST(strftime('%s','now') AS INTEGER) AS ts") in now_rows[0].ts) < (if rec.has(body, "ts_unix") then rec.get(body, "ts_unix") else 0) then err_json_h(400, "ts_unix is in the future")
  else
    let obj = ctx.qasim_objects.order(
      (if rec.has(body, "order_id") then rec.get(body, "order_id") else ""),
      (if rec.has(body, "account") then rec.get(body, "account") else ""),
      (if rec.has(body, "instrument") then rec.get(body, "instrument") else ""),
      (if rec.has(body, "side") then rec.get(body, "side") else ""),
      (if rec.has(body, "qty") then rec.get(body, "qty") else 0),
      (if rec.has(body, "order_type") then rec.get(body, "order_type") else ""),
      (if rec.has(body, "limit_price") then rec.get(body, "limit_price") else 0),
      (if rec.has(body, "ts_unix") then rec.get(body, "ts_unix") else 0),
      issuer_pk_hex, sig_b64
    ) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR IGNORE INTO orders (digest,order_id,account,instrument,side,qty,order_type,limit_price,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      obj.digest, "','", obj.payload.order_id, "','", obj.payload.account, "','",
      obj.payload.instrument, "','", obj.payload.side, "',",
      str.from(obj.payload.qty), ",'", obj.payload.order_type, "',",
      str.from(obj.payload.limit_price), ",", str.from(obj.payload.ts_unix), ",'",
      issuer_pk_hex, "','", sig_b64, "','", payload_json, "')"
    ])) in
    let _ = sqlite.exec(db, str.concat([
      "INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
      obj.digest, "','", obj.object_type, "','", obj.payload.account, "','",
      obj.payload.instrument, "',", str.from(obj.payload.ts_unix), ",'",
      issuer_pk_hex, "','", sig_b64, "','", payload_json, "')"
    ])) in
    ok_json_h({ object_type: obj.object_type, digest: obj.digest })
}

