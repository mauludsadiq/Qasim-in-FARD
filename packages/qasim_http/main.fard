  let inst_rows = instrument_rows(db)
  let positions = state_mod.positions_from_fills_with_meta(fills, prices, prices_mod, inst_rows)
  let receipt = state_mod.state_receipt_verified(account, fills, cash, prices, positions, now, verification_summary)
  ok_json({ account: account, fills: fills, cash: cash, prices: prices, positions: positions, cash_balance: state_mod.cash_balance_of(cash), nav: state_mod.nav_of(positions, state_mod.cash_balance_of(cash)), risk_state: receipt.risk_state, state_digest: receipt.state_digest, fill_count: receipt.fill_count, cash_count: receipt.cash_count, price_count: receipt.price_count })
}

