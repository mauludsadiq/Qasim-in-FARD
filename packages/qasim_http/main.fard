import("std/str") as str
import("std/list") as list
import("std/rec") as rec
import("std/json") as json
import("std/hash") as hash
import("std/sqlite") as sqlite
fn instrument_rows(db) {
  list.map(
    sqlite.query(db, "SELECT payload_json FROM object_store WHERE object_type='instrument'"),
    fn(r) { json.decode(r.payload_json) }
  )
}

fn instrument_meta(instrument_rows, instrument_id) {
  let hit = list.find(instrument_rows, fn(r) { r.instrument_id == instrument_id })
  if rec.has(hit, "some") then hit.some else null
}

fn corporate_action_rows(db) {
  list.map(
    sqlite.query(db, "SELECT payload_json FROM object_store WHERE object_type='corporate_action' ORDER BY ts_unix, digest"),
    fn(r) { json.decode(r.payload_json) }
  )
}

fn current_ts(db) {
  let rows = sqlite.query(db, "SELECT CAST(strftime('%s','now') AS INTEGER) AS ts") in
  rows[0].ts
}

fn compliance_rule_rows(db, account) {
  list.map(
    sqlite.query(db, str.concat([
      "SELECT payload_json FROM object_store WHERE object_type='compliance_rule' AND (account='",
      account, "' OR account='*')"
    ])),
    fn(r) { json.decode(r.payload_json) }
  )
}

fn cash_flow_rows(db, account) {
  list.map(
    sqlite.query(db, str.concat([
      "SELECT payload_json FROM object_store WHERE object_type='cash_flow' AND account='",
      account, "'"
    ])),
    fn(r) { json.decode(r.payload_json) }
  )
}

fn fill_rows_for_account(db, account) {
  list.map(sqlite.query(db, str.concat([
    "SELECT digest,payload_json,issuer_pk_hex,sig_b64 FROM object_store WHERE object_type='fill' AND account='",
    account,
    "' ORDER BY ts_unix, digest"
  ])), fn(r) {
    let p = json.decode(r.payload_json)
    {
      digest: r.digest,
      fill_id: p.fill_id,
      order_id: p.order_id,
      account: p.account,
      instrument: p.instrument,
      side: p.side,
      qty: p.qty,
      price: p.price,
      ts_unix: p.ts_unix,
      issuer_pk_hex: r.issuer_pk_hex,
      sig_b64: r.sig_b64,
      payload_json: r.payload_json
    }
  })
}

fn cash_flow_rows(db, account) {
  list.map(
    sqlite.query(db, str.concat([
      "SELECT payload_json FROM object_store WHERE object_type='cash_flow' AND account='",
      account, "'"
    ])),
    fn(r) { json.decode(r.payload_json) }
  )
}

fn fill_rows_for_account_at(db, account, ts_unix_cutoff) {
  list.map(sqlite.query(db, str.concat([
    "SELECT digest,payload_json,issuer_pk_hex,sig_b64 FROM object_store WHERE object_type='fill' AND account='",
    account,
    "' AND ts_unix<=",
    str.from(ts_unix_cutoff),
    " ORDER BY ts_unix, digest"
  ])), fn(r) {
    let p = json.decode(r.payload_json)
    {
      digest: r.digest,
      fill_id: p.fill_id,
      order_id: p.order_id,
      account: p.account,
      instrument: p.instrument,
      side: p.side,
      qty: p.qty,
      price: p.price,
      ts_unix: p.ts_unix,
      issuer_pk_hex: r.issuer_pk_hex,
      sig_b64: r.sig_b64,
      payload_json: r.payload_json
    }
  })
}

fn cash_rows_for_account(db, account) {
  list.map(sqlite.query(db, str.concat([
    "SELECT digest,payload_json,issuer_pk_hex,sig_b64 FROM object_store WHERE object_type='cash' AND account='",
    account,
    "' ORDER BY ts_unix, digest"
  ])), fn(r) {
    let p = json.decode(r.payload_json)
    {
      digest: r.digest,
      account: p.account,
      currency: p.currency,
      amount: p.amount,
      ts_unix: p.ts_unix,
      issuer_pk_hex: r.issuer_pk_hex,
      sig_b64: r.sig_b64,
      payload_json: r.payload_json
    }
  })
}

fn cash_rows_for_account_at(db, account, ts_unix_cutoff) {
  list.map(sqlite.query(db, str.concat([
    "SELECT digest,payload_json,issuer_pk_hex,sig_b64 FROM object_store WHERE object_type='cash' AND account='",
    account,
    "' AND ts_unix<=",
    str.from(ts_unix_cutoff),
    " ORDER BY ts_unix, digest"
  ])), fn(r) {
    let p = json.decode(r.payload_json)
    {
      digest: r.digest,
      account: p.account,
      currency: p.currency,
      amount: p.amount,
      ts_unix: p.ts_unix,
      issuer_pk_hex: r.issuer_pk_hex,
      sig_b64: r.sig_b64,
      payload_json: r.payload_json
    }
  })
}

fn tx_rows_for_account(db, account) {
  sqlite.query(db, str.concat([
    "SELECT digest,id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json FROM tx WHERE account='",
    account,
    "' ORDER BY ts_unix, digest"
  ]))
}

fn tx_rows_for_account_at(db, account, ts_unix_cutoff) {
  sqlite.query(db, str.concat([
    "SELECT digest,id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json FROM tx WHERE account='",
    account,
    "' AND ts_unix<=",
    str.from(ts_unix_cutoff),
    " ORDER BY ts_unix, digest"
  ]))
}

fn price_aggregate(req, db, prices_mod, ok_json) {
  let prefix = "/finance/price/aggregate/"
  let symbol = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path)))
  let rows = prices_mod.latest_price_rows(db)
  ok_json(prices_mod.aggregate_symbol_prices(rows, symbol))
}

fn get_position(req, db, prices_mod, state_mod, max_price_age, ok_json, position_cache, mutex_mod, ctx) {
  let prefix = "/finance/position/"
  let account = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path)))
  let raw_fills = fill_rows_for_account(db, account)
  let raw_cash = cash_rows_for_account(db, account)
  let now = current_ts(db)
  let prices = prices_mod.price_rows_at(db, now, max_price_age)
  let all_prices = prices_mod.all_price_rows(db)
  let inst_rows = instrument_rows(db)
  let ca_rows = corporate_action_rows(db)
  let fills_vs = verify_rows(raw_fills, ctx)
  let cash_vs = verify_rows(raw_cash, ctx)
  let fills = filter_verified_rows(raw_fills, ctx)
  let cash = filter_verified_rows(raw_cash, ctx)
  let verification_summary = { fills: fills_vs, cash: cash_vs, all_valid: fills_vs.all_valid && cash_vs.all_valid }
  let fill_key = list.fold(fills, "", fn(acc, r) { str.concat([acc, r.digest]) })
  let cash_key = list.fold(cash, "", fn(acc, r) { str.concat([acc, r.digest]) })
  let price_key = list.fold(prices, "", fn(acc, r) { str.concat([acc, r.digest]) })
  let ca_key = list.fold(ca_rows, "", fn(acc, r) { if rec.has(r, "action_id") then str.concat([acc, r.action_id]) else acc })
  let cache_key = hash.sha256_text(str.concat([account, fill_key, cash_key, price_key, ca_key]))
  let cache = mutex_mod.lock(position_cache)
  let cached = if rec.has(cache, cache_key) then rec.get(cache, cache_key) else null
  let positions = if cached != null then cached
    else
      let computed = state_mod.positions_from_fills_with_actions(fills, prices, prices_mod, inst_rows, ca_rows, null) in
      let new_cache = rec.set(cache, cache_key, computed) in
      let _ = mutex_mod.unlock(position_cache, new_cache) in
      computed
  let dividend_cash = state_mod.dividend_cash_of(fills, ca_rows, now)
  let fx_rates = state_mod.fx_rates_from_prices(prices, prices_mod)
  let nav_usd = state_mod.nav_usd_of(positions, cash, fx_rates)
  let risk_state_var = state_mod.risk_state_with_var(positions, state_mod.cash_balance_of(cash), all_prices)
  let receipt = state_mod.state_receipt_verified(account, fills, cash, prices, positions, now, verification_summary)
  let flows = cash_flow_rows(db, account) in
  let private_summary = state_mod.private_nav_summary(flows, 0.08, now) in
  let public_nav = state_mod.nav_of(positions, state_mod.cash_balance_of(cash)) in
  let total_nav = public_nav + private_summary.nav in
  let total_nav_usd = nav_usd + private_summary.nav in
  let risk_with_private = rec.set(rec.set(risk_state_var, "private_nav", private_summary.nav), "pv_capital_calls", private_summary.pv_capital_calls) in
  ok_json({ account: account, as_of_ts: now, verified: receipt.verified, verification_digest: receipt.verification_digest, verification_summary: verification_summary, positions: positions, cash_balance: state_mod.cash_balance_of(cash), public_nav: public_nav, public_nav_usd: nav_usd, private_nav: private_summary, total_nav: total_nav, total_nav_usd: total_nav_usd, dividend_cash: dividend_cash, fx_rates: fx_rates, risk_state: risk_with_private, state_digest: receipt.state_digest, meta: { fill_count: receipt.fill_count, cash_count: receipt.cash_count, price_count: receipt.price_count } })
}



fn post_cash_flow_h(req, ctx) {
  let db = ctx.db in
  let body = json.decode(req.body) in
  let payload_json = if rec.has(body, "payload_json") then rec.get(body, "payload_json") else "" in
  let issuer_pk_hex = if rec.has(body, "issuer_pk_hex") then rec.get(body, "issuer_pk_hex") else "" in
  let sig_b64 = if rec.has(body, "sig_b64") then rec.get(body, "sig_b64") else "" in
  if payload_json == "" then err_json_h(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json_h(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json_h(400, "missing sig_b64")
  else if !verify_payload_h(ctx, issuer_pk_hex, sig_b64, payload_json) then err_json_h(401, "bad sig")
  else
    let p = json.decode(payload_json) in
    let flow_id = if rec.has(p, "flow_id") then p.flow_id else "" in
    let account = if rec.has(p, "account") then p.account else "" in
    if flow_id == "" then err_json_h(400, "missing flow_id")
    else if account == "" then err_json_h(400, "missing account")
    else
      let obj = ctx.qasim_objects.cash_flow(
        flow_id,
        (if rec.has(p, "asset_id") then p.asset_id else ""),
        account,
        (if rec.has(p, "flow_type") then p.flow_type else "distribution"),
        (if rec.has(p, "amount") then p.amount else 0),
        (if rec.has(p, "currency") then p.currency else "USD"),
        (if rec.has(p, "expected_ts") then p.expected_ts else 0),
        issuer_pk_hex, sig_b64
      ) in
      let _ = sqlite.exec(db, str.concat([
        "INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
        obj.digest, "','cash_flow','", account, "',NULL,0,'",
        issuer_pk_hex, "','", sig_b64, "','", payload_json, "')"
      ])) in
      ok_json_h({ object_type: obj.object_type, digest: obj.digest, flow_id: flow_id, account: account })
}

fn private_nav_h(req, ctx) {
  let db = ctx.db in
  let prefix = "/finance/private/nav/" in
  let account = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path))) in
  if account == "" then err_json_h(400, "missing account")
  else
    let now = current_ts(db) in
    let flows = cash_flow_rows(db, account) in
    let discount_rate = 0.08 in
    let summary = ctx.qasim_state.private_nav_summary(flows, discount_rate, now) in
    ok_json_h({ account: account, as_of_ts: now, private_nav: summary })
}

fn open_orders_for_instrument(db, instrument) {
  sqlite.query(db, str.concat([
    "SELECT order_id, account, instrument, side, qty, order_type, limit_price, ts_unix, filled_qty, status, issuer_pk_hex, sig_b64, payload_json FROM orders WHERE instrument='",
    instrument, "' AND status='open' ORDER BY ts_unix ASC"
  ]))
}

fn can_match(buy_order, sell_order) {
  let buy_limit = if rec.has(buy_order, "limit_price") then buy_order.limit_price else null in
  let sell_limit = if rec.has(sell_order, "limit_price") then sell_order.limit_price else null in
  let buy_type = if rec.has(buy_order, "order_type") then buy_order.order_type else "limit" in
  let sell_type = if rec.has(sell_order, "order_type") then sell_order.order_type else "limit" in
  if buy_type == "market" || sell_type == "market" then true
  else if buy_limit == null || sell_limit == null then false
  else buy_limit >= sell_limit
}

fn match_price(buy_order, sell_order) {
  let buy_type = if rec.has(buy_order, "order_type") then buy_order.order_type else "limit" in
  let sell_type = if rec.has(sell_order, "order_type") then sell_order.order_type else "limit" in
  let buy_limit = if rec.has(buy_order, "limit_price") then buy_order.limit_price else 0 in
  let sell_limit = if rec.has(sell_order, "limit_price") then sell_order.limit_price else 0 in
  if sell_type == "limit" then sell_limit
  else if buy_type == "limit" then buy_limit
  else (buy_limit + sell_limit) / 2
}

fn match_qty(buy_order, sell_order) {
  let buy_remain = buy_order.qty - (if rec.has(buy_order, "filled_qty") then buy_order.filled_qty else 0) in
  let sell_remain = sell_order.qty - (if rec.has(sell_order, "filled_qty") then sell_order.filled_qty else 0) in
  if buy_remain < sell_remain then buy_remain else sell_remain
}

fn match_compliance_check(db, ctx, account, instrument, side, qty, price, now) {
  let raw_fills = fill_rows_for_account(db, account) in
  let raw_cash = cash_rows_for_account(db, account) in
  let fills = filter_verified_rows(raw_fills, ctx) in
  let cash = filter_verified_rows(raw_cash, ctx) in
  let prices = ctx.qasim_prices.price_rows_at(db, now, ctx.max_price_age) in
  let all_prices = ctx.qasim_prices.all_price_rows(db) in
  let inst_rows = instrument_rows(db) in
  let ca_rows = corporate_action_rows(db) in
  let rules = compliance_rule_rows(db, account) in
  let current_positions = ctx.qasim_state.positions_from_fills_with_actions(fills, prices, ctx.qasim_prices, inst_rows, ca_rows, null) in
  let synthetic_fill = { digest: "match-synthetic", fill_id: "match", order_id: "match", account: account, instrument: instrument, side: side, qty: qty, price: price, ts_unix: now, issuer_pk_hex: "match", sig_b64: "match", payload_json: "{}" } in
  let hypo_fills = list.append(fills, synthetic_fill) in
  let hypo_positions = ctx.qasim_state.positions_from_fills_with_actions(hypo_fills, prices, ctx.qasim_prices, inst_rows, ca_rows, null) in
  let cash_balance = ctx.qasim_state.cash_balance_of(cash) in
  let trade_cost = if side == "buy" then qty * price else 0 - (qty * price) in
  let current_risk = ctx.qasim_state.risk_state_with_var(current_positions, cash_balance, all_prices) in
  let hypo_risk = ctx.qasim_state.risk_state_with_var(hypo_positions, cash_balance - trade_cost, all_prices) in
  let current_compliance = ctx.qasim_state.evaluate_compliance(rules, current_positions, current_risk, now) in
  let hypo_compliance = ctx.qasim_state.evaluate_compliance(rules, hypo_positions, hypo_risk, now) in
  let new_breaches = list.filter(hypo_compliance.breaches, fn(hb) {
    !rec.has(list.find(current_compliance.breaches, fn(cb) { cb.rule_id == hb.rule_id }), "some")
  }) in
  let new_hard = list.filter(new_breaches, fn(b) { b.severity == "hard" }) in
  { blocked: list.len(new_hard) > 0, new_hard_breaches: list.len(new_hard), new_breaches: new_breaches }
}

fn run_matching_h(req, ctx) {
  let db = ctx.db in
  let body = json.decode(req.body) in
  let instrument = if rec.has(body, "instrument") then rec.get(body, "instrument") else "" in
  let issuer_pk_hex = if rec.has(body, "issuer_pk_hex") then rec.get(body, "issuer_pk_hex") else "SYSTEM" in
  let compliance_mode = if rec.has(body, "compliance_mode") then rec.get(body, "compliance_mode") else "block_on_hard" in
  if instrument == "" then err_json_h(400, "missing instrument")
  else
    let now = current_ts(db) in
    let orders = open_orders_for_instrument(db, instrument) in
    let buys = list.filter(orders, fn(o) { o.side == "buy" }) in
    let sells = list.filter(orders, fn(o) { o.side == "sell" }) in
    let result = list.fold(buys, { fills: [], blocked: [], updated_orders: [] }, fn(acc, buy) {
      let buy_remain = buy.qty - (if rec.has(buy, "filled_qty") then buy.filled_qty else 0) in
      if buy_remain <= 0 then acc
      else
        let match_result = list.fold(sells, { fills: acc.fills, buy_filled: 0, buy_done: false, blocked: acc.blocked }, fn(sacc, sell) {
          if sacc.buy_done then sacc
          else
            let sell_remain = sell.qty - (if rec.has(sell, "filled_qty") then sell.filled_qty else 0) in
            if sell_remain <= 0 then sacc
            else if !can_match(buy, sell) then sacc
            else
              let qty = if (buy_remain - sacc.buy_filled) < sell_remain then (buy_remain - sacc.buy_filled) else sell_remain in
              if qty <= 0 then sacc
              else
                let price = match_price(buy, sell) in
                let buy_check = if compliance_mode == "block_on_hard" then match_compliance_check(db, ctx, buy.account, instrument, "buy", qty, price, now) else { blocked: false, new_hard_breaches: 0, new_breaches: [] } in
                let sell_check = if compliance_mode == "block_on_hard" then match_compliance_check(db, ctx, sell.account, instrument, "sell", qty, price, now) else { blocked: false, new_hard_breaches: 0, new_breaches: [] } in
                if buy_check.blocked || sell_check.blocked then
                  { fills: sacc.fills, buy_filled: sacc.buy_filled, buy_done: sacc.buy_done, blocked: list.append(sacc.blocked, { buy_order: buy.order_id, sell_order: sell.order_id, qty: qty, price: price, reason: "compliance_block", buy_breaches: buy_check.new_breaches, sell_breaches: sell_check.new_breaches }) }
                else
                let fill_id = str.concat(["FILL-", buy.order_id, "-", sell.order_id, "-", str.from(now)]) in
                let buy_fill = {
                  fill_id: str.concat([fill_id, "-B"]),
                  order_id: buy.order_id,
                  account: buy.account,
                  instrument: instrument,
                  side: "buy",
                  qty: qty,
                  price: price,
                  ts_unix: now
                } in
                let sell_fill = {
                  fill_id: str.concat([fill_id, "-S"]),
                  order_id: sell.order_id,
                  account: sell.account,
                  instrument: instrument,
                  side: "sell",
                  qty: qty,
                  price: price,
                  ts_unix: now
                } in
                let buy_pj = json.canonicalize(buy_fill) in
                let sell_pj = json.canonicalize(sell_fill) in
                let buy_obj = ctx.qasim_objects.fill(buy_fill.fill_id, buy.order_id, buy.account, instrument, "buy", qty, price, now, issuer_pk_hex, "SYSTEM") in
                let sell_obj = ctx.qasim_objects.fill(sell_fill.fill_id, sell.order_id, sell.account, instrument, "sell", qty, price, now, issuer_pk_hex, "SYSTEM") in
                let _ = sqlite.exec(db, str.concat([
                  "INSERT OR IGNORE INTO fills (digest,fill_id,order_id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
                  buy_obj.digest, "','", buy_fill.fill_id, "','", buy.order_id, "','", buy.account, "','",
                  instrument, "','buy',", str.from(qty), ",", str.from(price), ",", str.from(now), ",'",
                  issuer_pk_hex, "','SYSTEM','", buy_pj, "')"
                ])) in
                let _ = sqlite.exec(db, str.concat([
                  "INSERT OR IGNORE INTO fills (digest,fill_id,order_id,account,instrument,side,qty,price,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
                  sell_obj.digest, "','", sell_fill.fill_id, "','", sell.order_id, "','", sell.account, "','",
                  instrument, "','sell',", str.from(qty), ",", str.from(price), ",", str.from(now), ",'",
                  issuer_pk_hex, "','SYSTEM','", sell_pj, "')"
                ])) in
                let _ = sqlite.exec(db, str.concat([
                  "INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
                  buy_obj.digest, "','fill','", buy.account, "','", instrument, "',", str.from(now), ",'", issuer_pk_hex, "','SYSTEM','", buy_pj, "')"
                ])) in
                let _ = sqlite.exec(db, str.concat([
                  "INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
                  sell_obj.digest, "','fill','", sell.account, "','", instrument, "',", str.from(now), ",'", issuer_pk_hex, "','SYSTEM','", sell_pj, "')"
                ])) in
                let new_sell_filled = (if rec.has(sell, "filled_qty") then sell.filled_qty else 0) + qty in
                let sell_status = if new_sell_filled >= sell.qty then "filled" else "partial" in
                let _ = sqlite.exec(db, str.concat([
                  "UPDATE orders SET filled_qty=", str.from(new_sell_filled), ", status='", sell_status, "' WHERE order_id='", sell.order_id, "'"
                ])) in
                { fills: list.append(list.append(sacc.fills, buy_fill), sell_fill), buy_filled: sacc.buy_filled + qty, buy_done: sacc.buy_filled + qty >= buy_remain, blocked: sacc.blocked }
        }) in
        let new_buy_filled = (if rec.has(buy, "filled_qty") then buy.filled_qty else 0) + match_result.buy_filled in
        let buy_status = if new_buy_filled >= buy.qty then "filled" else if match_result.buy_filled > 0 then "partial" else "open" in
        let _ = if match_result.buy_filled > 0 then sqlite.exec(db, str.concat([
          "UPDATE orders SET filled_qty=", str.from(new_buy_filled), ", status='", buy_status, "' WHERE order_id='", buy.order_id, "'"
        ])) else null in
        { fills: match_result.fills, blocked: match_result.blocked, updated_orders: acc.updated_orders }
    }) in
    ok_json_h({ instrument: instrument, as_of_ts: now, compliance_mode: compliance_mode, fills_generated: list.len(result.fills), fills: result.fills, blocked_matches: list.len(result.blocked), blocked: result.blocked })
}

fn orders_h(req, ctx) {
  let db = ctx.db in
  let prefix = "/finance/orders/" in
  let instrument = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path))) in
  let orders = if instrument == "" then
    sqlite.query(db, "SELECT order_id, account, instrument, side, qty, order_type, limit_price, ts_unix, filled_qty, status FROM orders ORDER BY ts_unix DESC LIMIT 100")
  else
    sqlite.query(db, str.concat([
      "SELECT order_id, account, instrument, side, qty, order_type, limit_price, ts_unix, filled_qty, status FROM orders WHERE instrument='",
      instrument, "' ORDER BY ts_unix DESC"
    ])) in
  ok_json_h({ orders: orders, count: list.len(orders) })
}


fn post_compliance_rule_h(req, ctx) {
  let db = ctx.db in
  let body = json.decode(req.body) in
  let payload_json = if rec.has(body, "payload_json") then rec.get(body, "payload_json") else "" in
  let issuer_pk_hex = if rec.has(body, "issuer_pk_hex") then rec.get(body, "issuer_pk_hex") else "" in
  let sig_b64 = if rec.has(body, "sig_b64") then rec.get(body, "sig_b64") else "" in
  if payload_json == "" then err_json_h(400, "missing payload_json")
  else if issuer_pk_hex == "" then err_json_h(400, "missing issuer_pk_hex")
  else if sig_b64 == "" then err_json_h(400, "missing sig_b64")
  else if !verify_payload_h(ctx, issuer_pk_hex, sig_b64, payload_json) then err_json_h(401, "bad sig")
  else
    let p = json.decode(payload_json) in
    let rule_id = if rec.has(p, "rule_id") then p.rule_id else "" in
    let account = if rec.has(p, "account") then p.account else "" in
    if rule_id == "" then err_json_h(400, "missing rule_id")
    else if account == "" then err_json_h(400, "missing account")
    else
      let obj = ctx.qasim_objects.compliance_rule(
        rule_id, account,
        (if rec.has(p, "rule_type") then p.rule_type else ""),
        (if rec.has(p, "params") then p.params else {}),
        (if rec.has(p, "severity") then p.severity else "hard"),
        (if rec.has(p, "effective_ts") then p.effective_ts else 0),
        (if rec.has(p, "expiry_ts") then p.expiry_ts else 0),
        issuer_pk_hex, sig_b64
      ) in
      let _ = sqlite.exec(db, str.concat([
        "INSERT OR IGNORE INTO object_store (digest,object_type,account,instrument,ts_unix,issuer_pk_hex,sig_b64,payload_json) VALUES ('",
        obj.digest, "','compliance_rule','", account, "',NULL,0,'",
        issuer_pk_hex, "','", sig_b64, "','", payload_json, "')"
      ])) in
      ok_json_h({ object_type: obj.object_type, digest: obj.digest, rule_id: rule_id, account: account })
}

fn compliance_check_h(req, ctx) {
  let db = ctx.db in
  let prefix = "/finance/compliance/" in
  let account = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path))) in
  if account == "" then err_json_h(400, "missing account")
  else
    let raw_fills = fill_rows_for_account(db, account) in
    let raw_cash = cash_rows_for_account(db, account) in
    let now = current_ts(db) in
    let prices = ctx.qasim_prices.price_rows_at(db, now, ctx.max_price_age) in
    let inst_rows = instrument_rows(db) in
    let ca_rows = corporate_action_rows(db) in
    let rules = compliance_rule_rows(db, account) in
    let fills = filter_verified_rows(raw_fills, ctx) in
    let cash = filter_verified_rows(raw_cash, ctx) in
    let vs = { fills: verify_rows(raw_fills, ctx), cash: verify_rows(raw_cash, ctx) } in
    let all_prices = ctx.qasim_prices.all_price_rows(db) in
    let positions = ctx.qasim_state.positions_from_fills_with_actions(fills, prices, ctx.qasim_prices, inst_rows, ca_rows, null) in
    let cash_balance = ctx.qasim_state.cash_balance_of(cash) in
    let base_risk = ctx.qasim_state.risk_state_with_var(positions, cash_balance, all_prices) in
    let flows = cash_flow_rows(db, account) in
    let private_summary = ctx.qasim_state.private_nav_summary(flows, 0.08, now) in
    let risk_state = rec.set(rec.set(base_risk, "private_nav", private_summary.nav), "pv_capital_calls", private_summary.pv_capital_calls) in
    let compliance = ctx.qasim_state.evaluate_compliance(rules, positions, risk_state, now) in
    ok_json_h({ account: account, as_of_ts: now, rule_count: list.len(rules), verification_summary: vs, private_nav_dcf: private_summary.nav, compliance: compliance })
}

fn compliance_at_h(req, ctx) {
  let db = ctx.db in
  let prefix = "/finance/compliance_at/" in
  let rest = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path))) in
  let parts = str.split(rest, "/") in
  let account = if list.len(parts) > 0 then parts[0] else "" in
  let ts_unix_cutoff = if list.len(parts) > 1 then parts[1] else "" in
  if account == "" then err_json_h(400, "missing account")
  else if ts_unix_cutoff == "" then err_json_h(400, "missing ts_unix")
  else
    let cutoff = json.decode(ts_unix_cutoff) in
    let fills = fill_rows_for_account_at(db, account, cutoff) in
    let cash = cash_rows_for_account_at(db, account, cutoff) in
    let prices = ctx.qasim_prices.price_rows_at(db, cutoff, ctx.max_price_age) in
    let inst_rows = instrument_rows(db) in
    let ca_rows = corporate_action_rows(db) in
    let rules = compliance_rule_rows(db, account) in
    let positions = ctx.qasim_state.positions_from_fills_with_actions(fills, prices, ctx.qasim_prices, inst_rows, ca_rows, cutoff) in
    let cash_balance = ctx.qasim_state.cash_balance_of(cash) in
    let risk_state = ctx.qasim_state.risk_state_of(positions, cash_balance) in
    let compliance = ctx.qasim_state.evaluate_compliance(rules, positions, risk_state, cutoff) in
    ok_json_h({ account: account, as_of_ts: cutoff, rule_count: list.len(rules), compliance: compliance })
}

fn attribution_h(req, ctx) {
  let db = ctx.db in
  let prefix = "/finance/attribution/" in
  let account = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path))) in
  if account == "" then err_json_h(400, "missing account")
  else
    let raw_fills = fill_rows_for_account(db, account) in
    let raw_cash = cash_rows_for_account(db, account) in
    let now = current_ts(db) in
    let prices = ctx.qasim_prices.price_rows_at(db, now, ctx.max_price_age) in
    let inst_rows = instrument_rows(db) in
    let ca_rows = corporate_action_rows(db) in
    let fills = filter_verified_rows(raw_fills, ctx) in
    let cash = filter_verified_rows(raw_cash, ctx) in
    let vs = { fills: verify_rows(raw_fills, ctx), cash: verify_rows(raw_cash, ctx) } in
    let positions = ctx.qasim_state.positions_from_fills_with_actions(fills, prices, ctx.qasim_prices, inst_rows, ca_rows, null) in
    let cash_balance = ctx.qasim_state.cash_balance_of(cash) in
    let nav = ctx.qasim_state.nav_of(positions, cash_balance) in
    let total_cost = list.fold(fills, 0, fn(acc, r) {
      if r.side == "buy" then acc + (r.qty * r.price) else acc
    }) in
    let beginning_nav = cash_balance + total_cost in
    let attribution = ctx.qasim_state.attribution_of(fills, positions, beginning_nav) in
    ok_json_h({
      account: account,
      as_of_ts: now,
      verification_summary: vs,
      current_nav: nav,
      cash_balance: cash_balance,
      attribution: attribution
    })
}

fn pretrade_h(req, ctx) {
  let db = ctx.db in
  let body = json.decode(req.body) in
  let account = if rec.has(body, "account") then rec.get(body, "account") else "" in
  let instrument = if rec.has(body, "instrument") then rec.get(body, "instrument") else "" in
  let side = if rec.has(body, "side") then rec.get(body, "side") else "" in
  let qty = if rec.has(body, "qty") then rec.get(body, "qty") else 0 in
  let price = if rec.has(body, "price") then rec.get(body, "price") else 0 in
  if account == "" then err_json_h(400, "missing account")
  else if instrument == "" then err_json_h(400, "missing instrument")
  else if side == "" then err_json_h(400, "missing side")
  else if qty == 0 then err_json_h(400, "missing qty")
  else
    let now = current_ts(db) in
    let raw_fills = fill_rows_for_account(db, account) in
    let raw_cash = cash_rows_for_account(db, account) in
    let fills = filter_verified_rows(raw_fills, ctx) in
    let cash = filter_verified_rows(raw_cash, ctx) in
    let vs = { fills: verify_rows(raw_fills, ctx), cash: verify_rows(raw_cash, ctx) } in
    let prices = ctx.qasim_prices.price_rows_at(db, now, ctx.max_price_age) in
    let all_prices = ctx.qasim_prices.all_price_rows(db) in
    let inst_rows = instrument_rows(db) in
    let ca_rows = corporate_action_rows(db) in
    let synthetic_fill = {
      digest: "pretrade-synthetic",
      fill_id: "pretrade",
      order_id: "pretrade",
      account: account,
      instrument: instrument,
      side: side,
      qty: qty,
      price: price,
      ts_unix: now,
      issuer_pk_hex: "pretrade",
      sig_b64: "pretrade",
      payload_json: "{}"
    } in
    let current_positions = ctx.qasim_state.positions_from_fills_with_actions(fills, prices, ctx.qasim_prices, inst_rows, ca_rows, null) in
    let hypo_fills = list.append(fills, synthetic_fill) in
    let hypo_positions = ctx.qasim_state.positions_from_fills_with_actions(hypo_fills, prices, ctx.qasim_prices, inst_rows, ca_rows, null) in
    let cash_balance = ctx.qasim_state.cash_balance_of(cash) in
    let trade_cost = if side == "buy" then qty * price else 0 - (qty * price) in
    let fx_rates = ctx.qasim_state.fx_rates_from_prices(prices, ctx.qasim_prices) in
    let current_nav = ctx.qasim_state.nav_of(current_positions, cash_balance) in
    let hypo_nav = ctx.qasim_state.nav_of(hypo_positions, cash_balance - trade_cost) in
    let current_risk = ctx.qasim_state.risk_state_with_var(current_positions, cash_balance, all_prices) in
    let hypo_risk = ctx.qasim_state.risk_state_with_var(hypo_positions, cash_balance - trade_cost, all_prices) in
    let compliance_mode = if rec.has(body, "compliance_mode") then rec.get(body, "compliance_mode") else "block_on_hard" in
    let rules = compliance_rule_rows(db, account) in
    let current_compliance = ctx.qasim_state.evaluate_compliance(rules, current_positions, current_risk, now) in
    let hypo_compliance = ctx.qasim_state.evaluate_compliance(rules, hypo_positions, hypo_risk, now) in
    let new_breaches = list.filter(hypo_compliance.breaches, fn(hb) {
      !rec.has(list.find(current_compliance.breaches, fn(cb) { cb.rule_id == hb.rule_id }), "some")
    }) in
    let resolved_breaches = list.filter(current_compliance.breaches, fn(cb) {
      !rec.has(list.find(hypo_compliance.breaches, fn(hb) { hb.rule_id == cb.rule_id }), "some")
    }) in
    let new_hard_breaches = list.filter(new_breaches, fn(b) { b.severity == "hard" }) in
    let trade_blocked = if compliance_mode == "warn" then false else list.len(new_hard_breaches) > 0 in
    let compliance_delta = {
      new_breaches: new_breaches,
      resolved_breaches: resolved_breaches,
      new_hard_breaches: list.len(new_hard_breaches),
      trade_blocked: trade_blocked,
      compliance_mode: compliance_mode
    } in
    ok_json_h({
      account: account,
      proposed: { instrument: instrument, side: side, qty: qty, price: price },
      current: { nav: current_nav, cash_balance: cash_balance, risk_state: current_risk, positions: current_positions },
      hypothetical: { nav: hypo_nav, cash_balance: cash_balance - trade_cost, risk_state: hypo_risk, positions: hypo_positions },
      delta: {
        nav: hypo_nav - current_nav,
        cash_balance: 0 - trade_cost,
        gross_exposure: hypo_risk.gross_exposure - current_risk.gross_exposure,
        leverage: if current_risk.leverage == null then null else hypo_risk.leverage - current_risk.leverage,
        concentration: if current_risk.concentration == null then null else hypo_risk.concentration - current_risk.concentration,
        portfolio_var_95: hypo_risk.portfolio_var_95 - current_risk.portfolio_var_95,
        portfolio_covar_var_95: hypo_risk.portfolio_covar_var_95 - current_risk.portfolio_covar_var_95,
        portfolio_es_95: hypo_risk.portfolio_es_95 - current_risk.portfolio_es_95
      },
      verification_summary: vs,
      current_compliance: current_compliance,
      hypo_compliance: hypo_compliance,
      compliance_delta: compliance_delta
    })
}

fn state_at(req, db, prices_mod, state_mod, max_price_age, ok_json, err_json) {
  let prefix = "/finance/state_at/"
  let rest = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path)))
  let parts = str.split(rest, "/")
  let account = if list.len(parts) > 0 then parts[0] else ""
  let ts_unix_cutoff = if list.len(parts) > 1 then parts[1] else ""
  if account == "" then err_json(400, "missing account")
  else if ts_unix_cutoff == "" then err_json(400, "missing ts_unix")
  else
    let cutoff = json.decode(str.concat([ts_unix_cutoff])) in
    let fills = fill_rows_for_account_at(db, account, cutoff) in
    let cash = cash_rows_for_account_at(db, account, cutoff) in
    let prices = prices_mod.price_rows_at(db, cutoff, max_price_age) in
    let inst_rows = instrument_rows(db) in
  let positions = state_mod.positions_from_fills_with_meta(fills, prices, prices_mod, inst_rows) in
    let receipt = state_mod.state_receipt_from_objects(account, fills, cash, prices, positions, cutoff) in
    ok_json({ account: account, as_of_ts: cutoff, positions: positions, cash_balance: state_mod.cash_balance_of(cash), nav: state_mod.nav_of(positions, state_mod.cash_balance_of(cash)), risk_state: receipt.risk_state, state_digest: receipt.state_digest, fill_count: receipt.fill_count, cash_count: receipt.cash_count, price_count: receipt.price_count })
}

fn export_account(req, db, prices_mod, state_mod, max_price_age, ok_json) {
  let prefix = "/finance/export/"
  let account = str.url_decode(str.slice(req.path, str.len(prefix), str.len(req.path)))
  let fills = fill_rows_for_account(db, account)
  let cash = cash_rows_for_account(db, account)
  let now = current_ts(db)
