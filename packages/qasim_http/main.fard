  list.map(sqlite.query(db, str.concat([
    "SELECT digest,payload_json,issuer_pk_hex,sig_b64 FROM object_store WHERE object_type='cash' AND account='",
    account,
    "' ORDER BY ts_unix, digest"
  ])), fn(r) {
    let p = json.decode(r.payload_json)
    {
      digest: r.digest,
      account: p.account,
      currency: p.currency,
      amount: p.amount,
      ts_unix: p.ts_unix,
      issuer_pk_hex: r.issuer_pk_hex,
      sig_b64: r.sig_b64,
      payload_json: r.payload_json
    }
  })
}

fn cash_rows_for_account_at(db, account, ts_unix_cutoff) {
  list.map(sqlite.query(db, str.concat([
    "SELECT digest,payload_json,issuer_pk_hex,sig_b64 FROM object_store WHERE object_type='cash' AND account='",
    account,
    "' AND ts_unix<=",
    str.from(ts_unix_cutoff),
    " ORDER BY ts_unix, digest"
  ])), fn(r) {
    let p = json.decode(r.payload_json)
    {
      digest: r.digest,
      account: p.account,
      currency: p.currency,
      amount: p.amount,
      ts_unix: p.ts_unix,
      issuer_pk_hex: r.issuer_pk_hex,
      sig_b64: r.sig_b64,
