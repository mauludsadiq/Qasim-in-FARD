import("std/sqlite") as sqlite
import("std/str") as str
import("std/list") as list
import("std/rec") as rec
import("std/json") as json

fn decode_price_rows(rows) {
  list.map(rows, fn(r) {
    let p = json.decode(r.payload_json)
    {
      symbol: p.symbol,
      mid: p.mid,
      venue: p.venue,
      ts_unix: p.ts_unix,
      digest: r.digest,
      issuer_pk_hex: r.issuer_pk_hex,
      sig_b64: r.sig_b64,
      payload_json: r.payload_json
    }
  })
}

fn latest_price_rows(db) {
  decode_price_rows(sqlite.query(db, "SELECT digest,payload_json,issuer_pk_hex,sig_b64 FROM object_store WHERE object_type='price_claim' ORDER BY ts_unix, digest"))
}

fn price_rows_at(db, ts_unix_cutoff, max_price_age) {
  let rows = decode_price_rows(sqlite.query(db, str.concat([
    "SELECT digest,payload_json,issuer_pk_hex,sig_b64 FROM object_store WHERE object_type='price_claim' AND ts_unix<=",
    str.from(ts_unix_cutoff),
    " ORDER BY ts_unix, digest"
  ])))
  list.filter(rows, fn(r) { (ts_unix_cutoff - r.ts_unix) <= max_price_age })
}

fn aggregate_symbol_prices(price_rows, symbol) {
  let rows = list.filter(price_rows, fn(r) { r.symbol == symbol })
  let n = list.len(rows)
  if n == 0 then { symbol: symbol, median: null, mean: null, weighted_mean: null, variance: null, outliers: [], sources: [] }
  else
    let now_ts = if n > 0 then list.fold(rows, 0, fn(acc, r) { if r.ts_unix > acc then r.ts_unix else acc }) else 0 in
    let weighted = list.map(rows, fn(r) {
      let age = now_ts - r.ts_unix in
      let w = if age < 0 then 1 else if age == 0 then 300 else 300 - age in
      let weight = if w < 1 then 1 else w in
      { mid: r.mid, weight: weight }
    }) in
    let weight_sum = list.fold(weighted, 0, fn(acc, x) { acc + x.weight }) in
    let weighted_sum = list.fold(weighted, 0, fn(acc, x) { acc + (x.mid * x.weight) }) in
    let weighted_mean = weighted_sum / weight_sum in
    let values = list.map(rows, fn(r) { r.mid }) in
    let sum = list.fold(values, 0, fn(acc, x) { acc + x }) in
    let mean = sum / n in
    let variance = list.fold(values, 0, fn(acc, x) { let d = x - mean in acc + (d * d) }) / n in
    let threshold = variance * 4 in
    let outliers = list.filter(rows, fn(r) { let d = r.mid - mean in (d * d) > threshold }) in
    { symbol: symbol, median: null, mean: mean, weighted_mean: weighted_mean, variance: variance, outliers: outliers, sources: rows }
}

fn aggregate_all_prices(price_rows) {
  let symbols = rec.keys(list.fold(price_rows, {}, fn(acc, r) {
    if rec.has(acc, r.symbol) then acc else rec.set(acc, r.symbol, true)
  }))
  list.map(symbols, fn(sym) { aggregate_symbol_prices(price_rows, sym) })
}

fn consensus_price(price_rows, symbol) {
  let agg = aggregate_symbol_prices(price_rows, symbol)
  agg.weighted_mean
}

{
  latest_price_rows: latest_price_rows,
  price_rows_at: price_rows_at,
  aggregate_symbol_prices: aggregate_symbol_prices,
  aggregate_all_prices: aggregate_all_prices,
  consensus_price: consensus_price
}
