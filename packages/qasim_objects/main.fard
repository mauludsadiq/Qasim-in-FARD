import("std/json") as json
import("std/hash") as hash
import("std/rec") as rec

fn canonical_digest(payload) {
  hash.sha256_text(json.canonicalize(payload))
}

fn signed_object(object_type, payload, issuer_pk_hex, sig_b64) {
  {
    object_type: object_type,
    payload: payload,
    issuer_pk_hex: issuer_pk_hex,
    sig_b64: sig_b64,
    digest: canonical_digest({
      object_type: object_type,
      payload: payload,
      issuer_pk_hex: issuer_pk_hex,
      sig_b64: sig_b64
    })
  }
}

fn instrument(instrument_id, asset_class, symbol, currency, venue, multiplier, expiry_ts_unix, issuer_pk_hex, sig_b64) {
  signed_object("instrument", {
    instrument_id: instrument_id,
    asset_class: asset_class,
    symbol: symbol,
    currency: currency,
    venue: venue,
    multiplier: multiplier,
    expiry_ts_unix: expiry_ts_unix
  }, issuer_pk_hex, sig_b64)
}

fn cash(account, currency, amount, ts_unix, issuer_pk_hex, sig_b64) {
  signed_object("cash", {
    account: account,
    currency: currency,
    amount: amount,
    ts_unix: ts_unix
  }, issuer_pk_hex, sig_b64)
}

fn order(order_id, account, instrument, side, qty, order_type, limit_price, ts_unix, issuer_pk_hex, sig_b64) {
  signed_object("order", {
    order_id: order_id,
    account: account,
    instrument: instrument,
    side: side,
    qty: qty,
    order_type: order_type,
    limit_price: limit_price,
    ts_unix: ts_unix
  }, issuer_pk_hex, sig_b64)
}

fn fill(fill_id, order_id, account, instrument, side, qty, price, ts_unix, issuer_pk_hex, sig_b64) {
  signed_object("fill", {
    fill_id: fill_id,
    order_id: order_id,
    account: account,
    instrument: instrument,
    side: side,
    qty: qty,
    price: price,
    ts_unix: ts_unix
  }, issuer_pk_hex, sig_b64)
}

fn price_claim(symbol, mid, venue, ts_unix, issuer_pk_hex, sig_b64) {
  signed_object("price_claim", {
    symbol: symbol,
    mid: mid,
    venue: venue,
    ts_unix: ts_unix
  }, issuer_pk_hex, sig_b64)
}

fn corporate_action(action_id, instrument, action_type, ex_ts_unix, effective_ts_unix, ratio_num, ratio_den, cash_amount, currency, issuer_pk_hex, sig_b64) {
  signed_object("corporate_action", {
    action_id: action_id,
    instrument: instrument,
    action_type: action_type,
    ex_ts_unix: ex_ts_unix,
    effective_ts_unix: effective_ts_unix,
    ratio_num: ratio_num,
    ratio_den: ratio_den,
    cash_amount: cash_amount,
    currency: currency
  }, issuer_pk_hex, sig_b64)
}

fn counterparty(counterparty_id, name, domicile, rating, issuer_pk_hex, sig_b64) {
  signed_object("counterparty", {
    counterparty_id: counterparty_id,
    name: name,
    domicile: domicile,
    rating: rating
  }, issuer_pk_hex, sig_b64)
}

fn portfolio(portfolio_id, account, base_currency, legal_entity, strategy, issuer_pk_hex, sig_b64) {
  signed_object("portfolio", {
    portfolio_id: portfolio_id,
    account: account,
    base_currency: base_currency,
    legal_entity: legal_entity,
    strategy: strategy
  }, issuer_pk_hex, sig_b64)
}

fn collateral(collateral_id, account, counterparty_id, collateral_type, amount, currency, ts_unix, issuer_pk_hex, sig_b64) {
  signed_object("collateral", {
    collateral_id: collateral_id,
    account: account,
    counterparty_id: counterparty_id,
    collateral_type: collateral_type,
    amount: amount,
    currency: currency,
    ts_unix: ts_unix
  }, issuer_pk_hex, sig_b64)
}


fn compliance_rule(rule_id, account, rule_type, params, severity, effective_ts, expiry_ts, issuer_pk_hex, sig_b64) {
  signed_object("compliance_rule", {
    rule_id: rule_id,
    account: account,
    rule_type: rule_type,
    params: params,
    severity: severity,
    effective_ts: effective_ts,
    expiry_ts: expiry_ts
  }, issuer_pk_hex, sig_b64)
}

{
  canonical_digest: canonical_digest,
  signed_object: signed_object,
  instrument: instrument,
  cash: cash,
  order: order,
  fill: fill,
  price_claim: price_claim,
  corporate_action: corporate_action,
  counterparty: counterparty,
  portfolio: portfolio,
  collateral: collateral,
  compliance_rule: compliance_rule
}
